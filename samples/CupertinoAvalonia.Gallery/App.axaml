<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ca="using:CupertinoAvalonia"
             x:Class="CupertinoAvalonia.Gallery.App"
             Name="CupertinoAvalonia Gallery"
             RequestedThemeVariant="Default">
  <!-- Name: the application menu's title on macOS. "Default" follows the system appearance. -->
  <Application.Styles>
    <ca:CupertinoAvaloniaTheme />
  </Application.Styles>
</Application>
