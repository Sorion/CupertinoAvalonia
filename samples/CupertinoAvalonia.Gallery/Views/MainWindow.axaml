<!-- The kit's "Unified Toolbar + Title + Sidebar" window (page Windows). -->
<cac:CupertinoWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cac="using:CupertinoAvalonia.Controls"
        xmlns:vm="using:CupertinoAvalonia.Gallery.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="760"
        x:Class="CupertinoAvalonia.Gallery.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="CupertinoAvalonia Gallery"
        Width="1100" Height="760"
        ExtendsContentIntoTitleBar="True"
        ToolbarStyle="Unified"
        Material="Sidebar">

  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <cac:CupertinoWindow.Styles>
    <!-- Without the sidebar, the toolbar makes room for the window controls, in step with the sidebar. -->
    <Style Selector="Border#ToolbarInset">
      <Setter Property="Transitions">
        <Transitions>
          <ThicknessTransition Property="Padding" Duration="{StaticResource SplitViewPaneDuration}" Easing="{StaticResource SplitViewPaneEasing}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="SplitView#Split:closed Border#ToolbarInset">
      <Setter Property="Padding" Value="{Binding $parent[cac:CupertinoWindow].WindowControlsInset}" />
    </Style>
  </cac:CupertinoWindow.Styles>

  <SplitView Name="Split" DisplayMode="Inline" IsPaneOpen="{Binding IsSidebarOpen}">
    <SplitView.Pane>
      <DockPanel>
        <!-- Room for the window controls. -->
        <Border DockPanel.Dock="Top" Height="52" Background="Transparent"
                WindowDecorationProperties.ElementRole="TitleBar" />
        <TextBlock DockPanel.Dock="Top" Classes="caption1 emphasized secondary" Margin="18,0,0,6" Text="Controls" />
        <ListBox Classes="sidebar"
                 ItemsSource="{Binding Pages}"
                 SelectedItem="{Binding SelectedPage}"
                 Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:GalleryPage">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <cac:SymbolIcon Width="24" Symbol="{Binding Icon}" />
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </SplitView.Pane>

    <Panel>
      <ScrollViewer Name="PageScroll">
        <ContentControl Margin="20,72,20,20" Content="{Binding SelectedPage.Content}" />
      </ScrollViewer>
      <cac:CupertinoToolbar ScrollViewer="{Binding #PageScroll}">
        <Border Name="ToolbarInset">
          <Grid Margin="10,0,12,0" ColumnDefinitions="Auto,*,Auto">
            <Button Classes="toolbar" VerticalAlignment="Center"
                    Command="{Binding ToggleSidebarCommand}"
                    ToolTip.Tip="Show or hide the sidebar">
              <cac:SymbolIcon Symbol="sidebar.left" />
            </Button>
            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Spacing="2" IsHitTestVisible="False">
              <TextBlock Classes="headline" Text="{Binding SelectedPage.Title}" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="subheadline secondary" Text="{Binding SelectedPage.Description}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <ComboBox Grid.Column="2" Classes="toolbar" Margin="12,0,0,0" MinWidth="90"
                      ItemsSource="{Binding Themes}"
                      SelectedItem="{Binding SelectedTheme}" />
          </Grid>
        </Border>
      </cac:CupertinoToolbar>
    </Panel>
  </SplitView>
</cac:CupertinoWindow>
