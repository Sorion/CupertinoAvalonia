<!-- The kit's "Unified Toolbar + Title + Sidebar" window (page Windows). -->
<cac:CupertinoWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cac="using:CupertinoAvalonia.Controls"
        xmlns:vm="using:CupertinoAvalonia.Gallery.ViewModels"
        xmlns:views="using:CupertinoAvalonia.Gallery.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="760"
        x:Class="CupertinoAvalonia.Gallery.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/logo.png"
        Title="CupertinoAvalonia Gallery"
        Width="1100" Height="760"
        ExtendsContentIntoTitleBar="True"
        ToolbarStyle="Unified"
        Material="Sidebar">

  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <!-- macOS's menu bar. -->
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="View">
        <NativeMenu Opening="OnViewMenuOpening">
          <!-- SwiftUI's SidebarCommands and InspectorCommands: NavigationSplitView has no shortcut of its own. -->
          <NativeMenuItem Header="Hide Sidebar" Gesture="Ctrl+Cmd+S" Click="OnToggleSidebarClick" />
          <NativeMenuItem Header="Show Inspector" Gesture="Ctrl+Cmd+I" Click="OnToggleInspectorClick" />
          <NativeMenuItemSeparator />
          <!-- To compare the gallery with a native app side by side, as only one window is active at a time. -->
          <NativeMenuItem Header="Always Look Active" ToggleType="CheckBox" Click="OnAlwaysLookActiveClick" />
          <!-- The sidebar's two selections: the accent while it has the focus (as TestNav), or always gray. -->
          <NativeMenuItem Header="Accent Sidebar Selection" ToggleType="CheckBox" IsChecked="True" Click="OnAccentSidebarSelectionClick" />
        </NativeMenu>
      </NativeMenuItem>
    </NativeMenu>
  </NativeMenu.Menu>

  <cac:CupertinoWindow.Styles>
    <!-- Wide content runs to the column's edge, as in SwiftUI: only the scroll viewer clips it, not the page's margin. -->
    <Style Selector="ContentControl#PageHost, ContentControl#PageHost > :is(UserControl)">
      <Setter Property="ClipToBounds" Value="False" />
    </Style>
  </cac:CupertinoWindow.Styles>

  <!-- TestNav's sidebar and inspector widths, to compare them. -->
  <cac:NavigationSplitView IsSidebarOpen="{Binding IsSidebarOpen}" MinSidebarWidth="180"
                           IsInspectorOpen="{Binding IsInspectorOpen}"
                           InspectorWidth="280" MinInspectorWidth="220" MaxInspectorWidth="400">
    <cac:NavigationSplitView.Sidebar>
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="caption1 emphasized secondary" Margin="18,0,0,6" Text="Controls" />
        <ListBox Name="Sidebar"
                 Classes="sidebar accent"
                 ItemsSource="{Binding Pages}"
                 SelectedItem="{Binding SelectedPage}"
                 Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:GalleryPage">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <cac:SymbolIcon Symbol="{Binding Icon}" />
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </cac:NavigationSplitView.Sidebar>

    <cac:NavigationSplitView.ContentToolbar>
      <Grid ColumnDefinitions="*,Auto,Auto">
        <StackPanel VerticalAlignment="Center" Spacing="2" IsHitTestVisible="False">
          <TextBlock Classes="headline" Text="{Binding SelectedPage.Title}" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="subheadline secondary" Text="{Binding SelectedPage.Description}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <ComboBox Grid.Column="1" Margin="12,0,0,0" MinWidth="90"
                  ItemsSource="{Binding Themes}"
                  SelectedItem="{Binding SelectedTheme}" />
        <Button Grid.Column="2" Margin="8,0,0,0"
                Command="{Binding ToggleInspectorCommand}"
                ToolTip.Tip="Show or hide the inspector"
                AutomationProperties.Name="Inspector">
          <cac:SymbolIcon Symbol="sidebar.right" />
        </Button>
      </Grid>
    </cac:NavigationSplitView.ContentToolbar>

    <!-- As in TestNav: the inspector's title in its section of the toolbar. -->
    <cac:NavigationSplitView.InspectorToolbar>
      <StackPanel Spacing="2" IsHitTestVisible="False">
        <TextBlock Classes="headline" Text="Channel options" />
        <TextBlock Classes="subheadline secondary" Text="Games" />
      </StackPanel>
    </cac:NavigationSplitView.InspectorToolbar>

    <cac:NavigationSplitView.Inspector>
      <views:ChannelInspector ShowsHeader="False" />
    </cac:NavigationSplitView.Inspector>

    <!-- The page starts below the toolbar and scrolls under it. -->
    <ScrollViewer Name="PageScroll" cac:CupertinoToolbar.ScrollsUnder="True">
      <ContentControl Name="PageHost" Margin="20" Content="{Binding SelectedPage.Content}" />
    </ScrollViewer>
  </cac:NavigationSplitView>
</cac:CupertinoWindow>
