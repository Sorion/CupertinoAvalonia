<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CupertinoAvalonia.Gallery.Views.Pages.TogglesPage">
  <StackPanel Spacing="28">
    <StackPanel Spacing="10">
      <TextBlock Classes="headline" Text="CheckBox" />
      <Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="28" RowSpacing="10">
        <CheckBox Content="Off" />
        <CheckBox Grid.Column="1" Content="On" IsChecked="True" />
        <CheckBox Grid.Column="2" Content="Mixed" IsThreeState="True" IsChecked="{x:Null}" />
        <CheckBox Grid.Row="1" Content="Off" IsEnabled="False" />
        <CheckBox Grid.Row="1" Grid.Column="1" Content="On" IsChecked="True" IsEnabled="False" />
        <CheckBox Grid.Row="1" Grid.Column="2" Content="Mixed" IsThreeState="True" IsChecked="{x:Null}" IsEnabled="False" />
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="20">
        <CheckBox Classes="mini" Content="Mini" IsChecked="True" />
        <CheckBox Classes="small" Content="Small" IsChecked="True" />
        <CheckBox Content="Regular" IsChecked="True" />
        <CheckBox Classes="large" Content="Large" IsChecked="True" />
      </StackPanel>
    </StackPanel>

    <StackPanel Spacing="10">
      <TextBlock Classes="headline" Text="RadioButton" />
      <StackPanel Orientation="Horizontal" Spacing="28">
        <StackPanel Spacing="8">
          <RadioButton GroupName="a" Content="Automatic" IsChecked="True" />
          <RadioButton GroupName="a" Content="Light" />
          <RadioButton GroupName="a" Content="Dark" />
        </StackPanel>
        <StackPanel Spacing="8">
          <RadioButton GroupName="b" Content="Disabled, selected" IsChecked="True" IsEnabled="False" />
          <RadioButton GroupName="b" Content="Disabled" IsEnabled="False" />
        </StackPanel>
      </StackPanel>
    </StackPanel>

    <StackPanel Spacing="10">
      <TextBlock Classes="headline" Text="ToggleSwitch" />
      <StackPanel Orientation="Horizontal" Spacing="20">
        <ToggleSwitch IsChecked="True" />
        <ToggleSwitch />
        <ToggleSwitch IsChecked="True" IsEnabled="False" />
        <ToggleSwitch IsEnabled="False" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="20">
        <ToggleSwitch Classes="mini" IsChecked="True" />
        <ToggleSwitch Classes="small" IsChecked="True" />
        <ToggleSwitch IsChecked="True" />
        <ToggleSwitch Classes="large" IsChecked="True" />
      </StackPanel>
      <ToggleSwitch Content="Launch MixerStudio at login" IsChecked="True" />
    </StackPanel>
  </StackPanel>
</UserControl>
