<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cac="using:CupertinoAvalonia.Controls"
             xmlns:gc="using:CupertinoAvalonia.Gallery.Controls"
             x:Class="CupertinoAvalonia.Gallery.Views.Pages.SlidersPage">
  <gc:SectionStack>

    <gc:GallerySection Title="Slider"
                       Description="A knob on a track, for a value in a range. Tick marks show steps; IsSnapToTickEnabled stops the knob on them."
                       Properties="Value Minimum Maximum TickFrequency TickPlacement IsSnapToTickEnabled Orientation">
      <gc:GalleryBlock Title="States" HintSymbol="cursorarrow" Hint="Drag the knob, or click the track.">
        <Grid ColumnDefinitions="134,224,224" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
          <TextBlock Grid.Column="1" Classes="subheadline secondary" Text="Normal" />
          <TextBlock Grid.Column="2" Classes="subheadline secondary" Text="Disabled" />

          <gc:RowLabel Grid.Row="1" Text="Continuous" Note="No property" />
          <Slider Grid.Row="1" Grid.Column="1" Width="200" HorizontalAlignment="Left" Value="40" />
          <Slider Grid.Row="1" Grid.Column="2" Width="200" HorizontalAlignment="Left" Value="40" IsEnabled="False" />

          <gc:RowLabel Grid.Row="2" Text="Tick marks" Code="TickPlacement" />
          <Slider Grid.Row="2" Grid.Column="1" Width="200" HorizontalAlignment="Left" Value="60"
                  TickFrequency="10" TickPlacement="BottomRight" IsSnapToTickEnabled="True" />
          <Slider Grid.Row="2" Grid.Column="2" Width="200" HorizontalAlignment="Left" Value="60"
                  TickFrequency="10" TickPlacement="BottomRight" IsEnabled="False" />

          <gc:RowLabel Grid.Row="3" Text="Vertical" Code="Orientation" />
          <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="24" Height="100">
            <Slider Orientation="Vertical" Value="70" />
            <Slider Orientation="Vertical" Value="50" TickFrequency="25" TickPlacement="BottomRight" IsSnapToTickEnabled="True" />
          </StackPanel>
          <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" Spacing="24" Height="100">
            <Slider Orientation="Vertical" Value="70" IsEnabled="False" />
            <Slider Orientation="Vertical" Value="50" TickFrequency="25" TickPlacement="BottomRight" IsEnabled="False" />
          </StackPanel>
        </Grid>
      </gc:GalleryBlock>

      <gc:GalleryBlock Title="In context">
        <Grid ColumnDefinitions="Auto,Auto,240,Auto,Auto" ColumnSpacing="8">
          <TextBlock Width="110" VerticalAlignment="Center" Text="Output volume" />
          <cac:CASymbolIcon Grid.Column="1" Symbol="speaker.fill" VerticalAlignment="Center"
                            Foreground="{DynamicResource LabelSecondaryBrush}" />
          <Slider Grid.Column="2" Name="Volume" Value="55" VerticalAlignment="Center" />
          <cac:CASymbolIcon Grid.Column="3" Symbol="speaker.wave.3.fill" VerticalAlignment="Center"
                            Foreground="{DynamicResource LabelSecondaryBrush}" />
          <TextBlock Grid.Column="4" Width="40" Margin="4,0,0,0" VerticalAlignment="Center" TextAlignment="Right"
                     Classes="secondary" Text="{Binding #Volume.Value, StringFormat='{}{0:0} %'}" />
        </Grid>
      </gc:GalleryBlock>
    </gc:GallerySection>

    <gc:GallerySection Title="ProgressBar"
                       Description="How far a task has gone, or, with IsIndeterminate, that it's under way. The circular class makes it a ring, or the spinner."
                       StyleClasses="circular" SizeClasses="mini small" Properties="Value IsIndeterminate">
      <gc:GalleryBlock Title="States">
        <Grid ColumnDefinitions="134,224,224" RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
          <TextBlock Grid.Column="1" Classes="subheadline secondary" Text="Determinate" />
          <TextBlock Grid.Column="2" Classes="subheadline secondary" Text="Indeterminate" />

          <gc:RowLabel Grid.Row="1" Text="Linear" Note="No class" />
          <ProgressBar Grid.Row="1" Grid.Column="1" Width="200" HorizontalAlignment="Left" VerticalAlignment="Center" Value="60" />
          <ProgressBar Grid.Row="1" Grid.Column="2" Width="200" HorizontalAlignment="Left" VerticalAlignment="Center" IsIndeterminate="True" />

          <gc:RowLabel Grid.Row="2" Text="Circular" Code="circular" />
          <ProgressBar Grid.Row="2" Grid.Column="1" Classes="circular" HorizontalAlignment="Left" VerticalAlignment="Center" Value="60" />
          <ProgressBar Grid.Row="2" Grid.Column="2" Classes="circular" HorizontalAlignment="Left" VerticalAlignment="Center" IsIndeterminate="True" />
        </Grid>
      </gc:GalleryBlock>

      <gc:GalleryBlock Title="Sizes">
        <Grid ColumnDefinitions="134,124,124,124,124,124" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="16">
          <TextBlock Grid.Column="1" Classes="subheadline secondary" Text="Mini" />
          <TextBlock Grid.Column="2" Classes="subheadline secondary" Text="Small" />
          <TextBlock Grid.Column="3" Classes="subheadline secondary" Text="Regular" />
          <TextBlock Grid.Column="4" Classes="subheadline secondary" Text="Large" />
          <TextBlock Grid.Column="5" Classes="subheadline secondary" Text="Extra Large" />

          <gc:RowLabel Grid.Row="1" Text="Linear" Note="No class" />
          <TextBlock Grid.Row="1" Grid.Column="1" Classes="tertiary" VerticalAlignment="Center" Text="—" />
          <ProgressBar Grid.Row="1" Grid.Column="2" Classes="small" Width="100" HorizontalAlignment="Left" VerticalAlignment="Center" Value="60" />
          <ProgressBar Grid.Row="1" Grid.Column="3" Width="100" HorizontalAlignment="Left" VerticalAlignment="Center" Value="60" />
          <TextBlock Grid.Row="1" Grid.Column="4" Classes="tertiary" VerticalAlignment="Center" Text="—" />
          <TextBlock Grid.Row="1" Grid.Column="5" Classes="tertiary" VerticalAlignment="Center" Text="—" />

          <gc:RowLabel Grid.Row="2" Text="Circular" Code="circular" />
          <ProgressBar Grid.Row="2" Grid.Column="1" Classes="circular mini" HorizontalAlignment="Left" VerticalAlignment="Center" Value="60" />
          <ProgressBar Grid.Row="2" Grid.Column="2" Classes="circular small" HorizontalAlignment="Left" VerticalAlignment="Center" Value="60" />
          <ProgressBar Grid.Row="2" Grid.Column="3" Classes="circular" HorizontalAlignment="Left" VerticalAlignment="Center" Value="60" />
          <TextBlock Grid.Row="2" Grid.Column="4" Classes="tertiary" VerticalAlignment="Center" Text="—" />
          <TextBlock Grid.Row="2" Grid.Column="5" Classes="tertiary" VerticalAlignment="Center" Text="—" />

          <gc:RowLabel Grid.Row="3" Text="Spinner" Code="IsIndeterminate" />
          <ProgressBar Grid.Row="3" Grid.Column="1" Classes="circular mini" HorizontalAlignment="Left" VerticalAlignment="Center" IsIndeterminate="True" />
          <ProgressBar Grid.Row="3" Grid.Column="2" Classes="circular small" HorizontalAlignment="Left" VerticalAlignment="Center" IsIndeterminate="True" />
          <ProgressBar Grid.Row="3" Grid.Column="3" Classes="circular" HorizontalAlignment="Left" VerticalAlignment="Center" IsIndeterminate="True" />
          <TextBlock Grid.Row="3" Grid.Column="4" Classes="tertiary" VerticalAlignment="Center" Text="—" />
          <TextBlock Grid.Row="3" Grid.Column="5" Classes="tertiary" VerticalAlignment="Center" Text="—" />
        </Grid>
      </gc:GalleryBlock>

      <gc:GalleryBlock Title="In context" HintSymbol="cursorarrow" Hint="Drag the slider: the bar and the ring follow its value.">
        <Grid ColumnDefinitions="320,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="6">
          <TextBlock Text="Exporting the profile “Games”…" />
          <ProgressBar Grid.Row="1" Value="{Binding #Export.Value}" />
          <ProgressBar Grid.Row="1" Grid.Column="1" Classes="circular small" Value="{Binding #Export.Value}" />
          <TextBlock Grid.Row="2" Classes="subheadline secondary" Text="{Binding #Export.Value, StringFormat='{}{0:0} % done'}" />
          <Slider Grid.Row="3" Name="Export" Margin="0,10,0,0" Width="200" HorizontalAlignment="Left" Value="30" />
        </Grid>
      </gc:GalleryBlock>
    </gc:GallerySection>

    <gc:GallerySection Title="Expander"
                       Description="A header that shows or hides the content under it, with a disclosure triangle. The button class makes it a disclosure button."
                       StyleClasses="button" Properties="Header IsExpanded">
      <gc:GalleryBlock Title="States" HintSymbol="cursorarrow" Hint="Click the header to show or hide the content.">
        <Grid ColumnDefinitions="134,184,184,184" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
          <TextBlock Grid.Column="1" Classes="subheadline secondary" Text="Collapsed" />
          <TextBlock Grid.Column="2" Classes="subheadline secondary" Text="Expanded" />
          <TextBlock Grid.Column="3" Classes="subheadline secondary" Text="Disabled" />

          <gc:RowLabel Grid.Row="1" Text="Disclosure" Note="No class" VerticalAlignment="Top" />
          <Expander Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" Header="Details" />
          <Expander Grid.Row="1" Grid.Column="2" VerticalAlignment="Top" Header="Details" IsExpanded="True">
            <TextBlock Classes="secondary" Text="Content" />
          </Expander>
          <Expander Grid.Row="1" Grid.Column="3" VerticalAlignment="Top" Header="Details" IsEnabled="False" />

          <gc:RowLabel Grid.Row="2" Text="Disclosure button" Code="button" />
          <Expander Grid.Row="2" Grid.Column="1" Classes="button" VerticalAlignment="Top" Header="Show more" />
          <Expander Grid.Row="2" Grid.Column="2" Classes="button" VerticalAlignment="Top" Header="Show more" IsExpanded="True" />
          <Expander Grid.Row="2" Grid.Column="3" Classes="button" VerticalAlignment="Top" Header="Show more" IsEnabled="False" />
        </Grid>
      </gc:GalleryBlock>

      <gc:GalleryBlock Title="In context">
        <StackPanel Width="320" HorizontalAlignment="Left" Spacing="10">
          <Expander Header="Output" IsExpanded="True">
            <StackPanel Spacing="6">
              <CheckBox Content="Follow the system output" IsChecked="True" />
              <CheckBox Content="Mute when the screen locks" />
            </StackPanel>
          </Expander>
          <Expander Header="Advanced">
            <TextBlock Classes="secondary" Text="Advanced options" />
          </Expander>
        </StackPanel>
      </gc:GalleryBlock>
    </gc:GallerySection>

    <gc:GallerySection Title="ScrollViewer"
                       Description="Content larger than its frame, with overlay scroll bars that appear while you scroll, as macOS's. AllowAutoHide=False keeps them shown."
                       Properties="AllowAutoHide VerticalScrollBarVisibility HorizontalScrollBarVisibility">
      <gc:GalleryBlock Title="States" Hint="The trackpad, the scroll wheel, or the arrow keys scroll the content.">
        <Grid ColumnDefinitions="224,224" RowDefinitions="Auto,Auto" RowSpacing="12">
          <TextBlock Classes="subheadline secondary" Text="While scrolling" />
          <TextBlock Grid.Column="1" Classes="subheadline secondary" Text="Always shown" />

          <Border Grid.Row="1" Width="200" Height="100" HorizontalAlignment="Left" CornerRadius="6"
                  BorderThickness="1" BorderBrush="{DynamicResource TableColumnSeparatorBrush}">
            <ScrollViewer>
              <TextBlock Margin="10" TextWrapping="Wrap" Text="{Binding #LongText.Text}" />
            </ScrollViewer>
          </Border>
          <Border Grid.Row="1" Grid.Column="1" Width="200" Height="100" HorizontalAlignment="Left" CornerRadius="6"
                  BorderThickness="1" BorderBrush="{DynamicResource TableColumnSeparatorBrush}">
            <ScrollViewer AllowAutoHide="False">
              <TextBlock Name="LongText" Margin="10" TextWrapping="Wrap"
                         Text="MixerStudio gives every application its own channel, so you can set the volume of music, games and calls independently. Each channel can be routed to a different output device, muted, or soloed. Profiles save a set of channels and rules and switch automatically when an application starts." />
            </ScrollViewer>
          </Border>
        </Grid>
      </gc:GalleryBlock>
    </gc:GallerySection>
  </gc:SectionStack>
</UserControl>
