<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gc="using:CupertinoAvalonia.Gallery.Controls"
             x:Class="CupertinoAvalonia.Gallery.Views.Pages.TypographyPage">
  <gc:SectionStack>

    <gc:GallerySection Title="Text styles"
                       Description="macOS's text styles, as TextBlock classes: the emphasized class gives each its bold weight, and secondary and tertiary its label colors."
                       StyleClasses="emphasized secondary tertiary">
      <gc:GalleryBlock Title="Styles">
        <Grid ColumnDefinitions="134,264,264" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
          <TextBlock Grid.Column="1" Classes="subheadline secondary" Text="Regular" />
          <TextBlock Grid.Column="2" Classes="subheadline secondary" Text="Emphasized" />

          <gc:RowLabel Grid.Row="1" Text="Large Title" Code="largeTitle" />
          <TextBlock Grid.Row="1" Grid.Column="1" Classes="largeTitle" VerticalAlignment="Center" Text="Large Title" />
          <TextBlock Grid.Row="1" Grid.Column="2" Classes="largeTitle emphasized" VerticalAlignment="Center" Text="Large Title" />
          <gc:RowLabel Grid.Row="2" Text="Title 1" Code="title1" />
          <TextBlock Grid.Row="2" Grid.Column="1" Classes="title1" VerticalAlignment="Center" Text="Title 1" />
          <TextBlock Grid.Row="2" Grid.Column="2" Classes="title1 emphasized" VerticalAlignment="Center" Text="Title 1" />
          <gc:RowLabel Grid.Row="3" Text="Title 2" Code="title2" />
          <TextBlock Grid.Row="3" Grid.Column="1" Classes="title2" VerticalAlignment="Center" Text="Title 2" />
          <TextBlock Grid.Row="3" Grid.Column="2" Classes="title2 emphasized" VerticalAlignment="Center" Text="Title 2" />
          <gc:RowLabel Grid.Row="4" Text="Title 3" Code="title3" />
          <TextBlock Grid.Row="4" Grid.Column="1" Classes="title3" VerticalAlignment="Center" Text="Title 3" />
          <TextBlock Grid.Row="4" Grid.Column="2" Classes="title3 emphasized" VerticalAlignment="Center" Text="Title 3" />
          <gc:RowLabel Grid.Row="5" Text="Headline" Code="headline" />
          <TextBlock Grid.Row="5" Grid.Column="1" Classes="headline" VerticalAlignment="Center" Text="Headline" />
          <TextBlock Grid.Row="5" Grid.Column="2" Classes="headline emphasized" VerticalAlignment="Center" Text="Headline" />
          <gc:RowLabel Grid.Row="6" Text="Body" Code="body" />
          <TextBlock Grid.Row="6" Grid.Column="1" Classes="body" VerticalAlignment="Center" Text="Body" />
          <TextBlock Grid.Row="6" Grid.Column="2" Classes="body emphasized" VerticalAlignment="Center" Text="Body" />
          <gc:RowLabel Grid.Row="7" Text="Callout" Code="callout" />
          <TextBlock Grid.Row="7" Grid.Column="1" Classes="callout" VerticalAlignment="Center" Text="Callout" />
          <TextBlock Grid.Row="7" Grid.Column="2" Classes="callout emphasized" VerticalAlignment="Center" Text="Callout" />
          <gc:RowLabel Grid.Row="8" Text="Subheadline" Code="subheadline" />
          <TextBlock Grid.Row="8" Grid.Column="1" Classes="subheadline" VerticalAlignment="Center" Text="Subheadline" />
          <TextBlock Grid.Row="8" Grid.Column="2" Classes="subheadline emphasized" VerticalAlignment="Center" Text="Subheadline" />
          <gc:RowLabel Grid.Row="9" Text="Footnote" Code="footnote" />
          <TextBlock Grid.Row="9" Grid.Column="1" Classes="footnote" VerticalAlignment="Center" Text="Footnote" />
          <TextBlock Grid.Row="9" Grid.Column="2" Classes="footnote emphasized" VerticalAlignment="Center" Text="Footnote" />
          <gc:RowLabel Grid.Row="10" Text="Caption 1" Code="caption1" />
          <TextBlock Grid.Row="10" Grid.Column="1" Classes="caption1" VerticalAlignment="Center" Text="Caption 1" />
          <TextBlock Grid.Row="10" Grid.Column="2" Classes="caption1 emphasized" VerticalAlignment="Center" Text="Caption 1" />
          <gc:RowLabel Grid.Row="11" Text="Caption 2" Code="caption2" />
          <TextBlock Grid.Row="11" Grid.Column="1" Classes="caption2" VerticalAlignment="Center" Text="Caption 2" />
          <TextBlock Grid.Row="11" Grid.Column="2" Classes="caption2 emphasized" VerticalAlignment="Center" Text="Caption 2" />
        </Grid>
      </gc:GalleryBlock>

      <gc:GalleryBlock Title="Label colors">
        <StackPanel Orientation="Horizontal" Spacing="16">
          <TextBlock Text="Primary" />
          <TextBlock Classes="secondary" Text="Secondary" />
          <TextBlock Classes="tertiary" Text="Tertiary" />
        </StackPanel>
      </gc:GalleryBlock>

      <gc:GalleryBlock Title="Font">
        <TextBlock Name="ResolvedFont" Classes="secondary" TextWrapping="Wrap" />
      </gc:GalleryBlock>
    </gc:GallerySection>

  </gc:SectionStack>
</UserControl>
