<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gc="using:CupertinoAvalonia.Gallery.Controls"
             x:Class="CupertinoAvalonia.Gallery.Views.Pages.TextFieldsPage">
  <gc:SectionStack>

    <gc:GallerySection Title="TextBox"
                       Description="A text field, on one line or, with AcceptsReturn, on several. The search class makes it a search field whose button clears the text."
                       StyleClasses="search" SizeClasses="mini small large"
                       Properties="PlaceholderText PasswordChar AcceptsReturn">
      <gc:GalleryBlock Title="States">
        <Grid ColumnDefinitions="134,214,214,190" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
          <TextBlock Grid.Column="1" Classes="subheadline secondary" Text="Empty" />
          <TextBlock Grid.Column="2" Classes="subheadline secondary" Text="Filled" />
          <TextBlock Grid.Column="3" Classes="subheadline secondary" Text="Disabled" />

          <gc:RowLabel Grid.Row="1" Text="Default" Note="No class" />
          <TextBox Grid.Row="1" Grid.Column="1" Width="190" HorizontalAlignment="Left" VerticalAlignment="Center" PlaceholderText="Placeholder" />
          <TextBox Grid.Row="1" Grid.Column="2" Width="190" HorizontalAlignment="Left" VerticalAlignment="Center" Text="Some text" />
          <TextBox Grid.Row="1" Grid.Column="3" Width="190" HorizontalAlignment="Left" VerticalAlignment="Center" Text="Some text" IsEnabled="False" />

          <gc:RowLabel Grid.Row="2" Text="Password" Code="PasswordChar" />
          <TextBox Grid.Row="2" Grid.Column="1" Width="190" HorizontalAlignment="Left" VerticalAlignment="Center" PasswordChar="•" PlaceholderText="Password" />
          <TextBox Grid.Row="2" Grid.Column="2" Width="190" HorizontalAlignment="Left" VerticalAlignment="Center" PasswordChar="•" Text="password" />
          <TextBox Grid.Row="2" Grid.Column="3" Width="190" HorizontalAlignment="Left" VerticalAlignment="Center" PasswordChar="•" Text="password" IsEnabled="False" />

          <gc:RowLabel Grid.Row="3" Text="Search field" Code="search" />
          <TextBox Grid.Row="3" Grid.Column="1" Width="190" HorizontalAlignment="Left" VerticalAlignment="Center" Classes="search" PlaceholderText="Search" />
          <TextBox Grid.Row="3" Grid.Column="2" Width="190" HorizontalAlignment="Left" VerticalAlignment="Center" Classes="search" Text="Channels" />
          <TextBox Grid.Row="3" Grid.Column="3" Width="190" HorizontalAlignment="Left" VerticalAlignment="Center" Classes="search" Text="Channels" IsEnabled="False" />
        </Grid>
      </gc:GalleryBlock>

      <gc:GalleryBlock Title="Sizes">
        <Grid ColumnDefinitions="134,144,144,144,144,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
          <TextBlock Grid.Column="1" Classes="subheadline secondary" Text="Mini" />
          <TextBlock Grid.Column="2" Classes="subheadline secondary" Text="Small" />
          <TextBlock Grid.Column="3" Classes="subheadline secondary" Text="Regular" />
          <TextBlock Grid.Column="4" Classes="subheadline secondary" Text="Large" />
          <TextBlock Grid.Column="5" Classes="subheadline secondary" Text="Extra Large" />

          <gc:RowLabel Grid.Row="1" Text="Default" Note="No class" />
          <TextBox Grid.Row="1" Grid.Column="1" Width="120" HorizontalAlignment="Left" VerticalAlignment="Center" Classes="mini" Text="Some text" />
          <TextBox Grid.Row="1" Grid.Column="2" Width="120" HorizontalAlignment="Left" VerticalAlignment="Center" Classes="small" Text="Some text" />
          <TextBox Grid.Row="1" Grid.Column="3" Width="120" HorizontalAlignment="Left" VerticalAlignment="Center" Text="Some text" />
          <TextBox Grid.Row="1" Grid.Column="4" Width="120" HorizontalAlignment="Left" VerticalAlignment="Center" Classes="large" Text="Some text" />
          <TextBlock Grid.Row="1" Grid.Column="5" Classes="tertiary" VerticalAlignment="Center" Text="—" />

          <gc:RowLabel Grid.Row="2" Text="Search field" Code="search" />
          <TextBox Grid.Row="2" Grid.Column="1" Width="120" HorizontalAlignment="Left" VerticalAlignment="Center" Classes="search mini" Text="Channels" />
          <TextBox Grid.Row="2" Grid.Column="2" Width="120" HorizontalAlignment="Left" VerticalAlignment="Center" Classes="search small" Text="Channels" />
          <TextBox Grid.Row="2" Grid.Column="3" Width="120" HorizontalAlignment="Left" VerticalAlignment="Center" Classes="search" Text="Channels" />
          <TextBox Grid.Row="2" Grid.Column="4" Width="120" HorizontalAlignment="Left" VerticalAlignment="Center" Classes="search large" Text="Channels" />
          <TextBlock Grid.Row="2" Grid.Column="5" Classes="tertiary" VerticalAlignment="Center" Text="—" />
        </Grid>
      </gc:GalleryBlock>

      <gc:GalleryBlock Title="In context" HintSymbol="cursorarrow"
                       Hint="A search field's clear button appears once there's text; click it to empty the field.">
        <StackPanel Spacing="6">
          <TextBlock Classes="subheadline secondary" Text="Notes" />
          <TextBox Width="520" Height="76" HorizontalAlignment="Left" AcceptsReturn="True" TextWrapping="Wrap"
                   Text="The mixer routes each application to its own channel. Type here to try the caret and the selection color." />
        </StackPanel>
      </gc:GalleryBlock>
    </gc:GallerySection>

    <gc:GallerySection Title="NumericUpDown"
                       Description="A number field with its stepper inside, or after it with the outside class. ButtonSpinner is the stepper on its own, or after any content."
                       StyleClasses="outside" SizeClasses="mini small large xlarge" Properties="Minimum Maximum FormatString">
      <gc:GalleryBlock Title="States"
                       Hint="Arrow keys, the scroll wheel and the stepper change the value; at a limit, that half of the stepper dims.">
        <Grid ColumnDefinitions="134,164,164,164" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
          <TextBlock Grid.Column="1" Classes="subheadline secondary" Text="Normal" />
          <TextBlock Grid.Column="2" Classes="subheadline secondary" Text="At a limit" />
          <TextBlock Grid.Column="3" Classes="subheadline secondary" Text="Disabled" />

          <gc:RowLabel Grid.Row="1" Text="NumericUpDown" Note="No class" />
          <NumericUpDown Grid.Row="1" Grid.Column="1" Width="110" HorizontalAlignment="Left" VerticalAlignment="Center" Value="12" Minimum="0" Maximum="100" />
          <NumericUpDown Grid.Row="1" Grid.Column="2" Width="110" HorizontalAlignment="Left" VerticalAlignment="Center" Value="100" Minimum="0" Maximum="100" FormatString="0' %'" />
          <NumericUpDown Grid.Row="1" Grid.Column="3" Width="110" HorizontalAlignment="Left" VerticalAlignment="Center" Value="12" IsEnabled="False" />

          <gc:RowLabel Grid.Row="2" Text="NumericUpDown" Code="outside" />
          <NumericUpDown Grid.Row="2" Grid.Column="1" Classes="outside" Width="110" HorizontalAlignment="Left" VerticalAlignment="Center" Value="12" Minimum="0" Maximum="100" />
          <NumericUpDown Grid.Row="2" Grid.Column="2" Classes="outside" Width="110" HorizontalAlignment="Left" VerticalAlignment="Center" Value="100" Minimum="0" Maximum="100" FormatString="0' %'" />
          <NumericUpDown Grid.Row="2" Grid.Column="3" Classes="outside" Width="110" HorizontalAlignment="Left" VerticalAlignment="Center" Value="12" IsEnabled="False" />

          <gc:RowLabel Grid.Row="3" Text="ButtonSpinner" Note="The stepper alone" />
          <ButtonSpinner Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" />
          <TextBlock Grid.Row="3" Grid.Column="2" Classes="tertiary" VerticalAlignment="Center" Text="—" />
          <ButtonSpinner Grid.Row="3" Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center" IsEnabled="False" />

          <gc:RowLabel Grid.Row="4" Text="ButtonSpinner" Code="Content" />
          <ButtonSpinner Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Content="4 copies" />
          <TextBlock Grid.Row="4" Grid.Column="2" Classes="tertiary" VerticalAlignment="Center" Text="—" />
          <ButtonSpinner Grid.Row="4" Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center" Content="4 copies" IsEnabled="False" />
        </Grid>
      </gc:GalleryBlock>

      <gc:GalleryBlock Title="Sizes">
        <Grid ColumnDefinitions="134,134,134,134,134" RowDefinitions="Auto,Auto" RowSpacing="12">
          <TextBlock Classes="subheadline secondary" Text="Mini" />
          <TextBlock Grid.Column="1" Classes="subheadline secondary" Text="Small" />
          <TextBlock Grid.Column="2" Classes="subheadline secondary" Text="Regular" />
          <TextBlock Grid.Column="3" Classes="subheadline secondary" Text="Large" />
          <TextBlock Grid.Column="4" Classes="subheadline secondary" Text="Extra Large" />

          <NumericUpDown Grid.Row="1" Classes="mini" Width="64" HorizontalAlignment="Left" VerticalAlignment="Center" Value="1" />
          <NumericUpDown Grid.Row="1" Grid.Column="1" Classes="small" Width="70" HorizontalAlignment="Left" VerticalAlignment="Center" Value="2" />
          <NumericUpDown Grid.Row="1" Grid.Column="2" Width="76" HorizontalAlignment="Left" VerticalAlignment="Center" Value="3" />
          <NumericUpDown Grid.Row="1" Grid.Column="3" Classes="large" Width="82" HorizontalAlignment="Left" VerticalAlignment="Center" Value="4" />
          <NumericUpDown Grid.Row="1" Grid.Column="4" Classes="xlarge" Width="92" HorizontalAlignment="Left" VerticalAlignment="Center" Value="5" />
        </Grid>
      </gc:GalleryBlock>
    </gc:GallerySection>

    <gc:GallerySection Title="AutoCompleteBox"
                       Description="A text field whose suggestions open in a menu as you type."
                       SizeClasses="mini small large" Properties="ItemsSource FilterMode">
      <gc:GalleryBlock Title="States" Hint="Type “g” or “m” to open the suggestions.">
        <Grid ColumnDefinitions="214,214" RowDefinitions="Auto,Auto" RowSpacing="12">
          <TextBlock Classes="subheadline secondary" Text="Empty" />
          <TextBlock Grid.Column="1" Classes="subheadline secondary" Text="Disabled" />

          <AutoCompleteBox Grid.Row="1" Classes="channels" Width="190" HorizontalAlignment="Left" PlaceholderText="Channel" />
          <AutoCompleteBox Grid.Row="1" Grid.Column="1" Width="190" HorizontalAlignment="Left" Text="Games" IsEnabled="False" />
        </Grid>
      </gc:GalleryBlock>

      <gc:GalleryBlock Title="Sizes">
        <Grid ColumnDefinitions="144,144,144,144,Auto" RowDefinitions="Auto,Auto" RowSpacing="12">
          <TextBlock Classes="subheadline secondary" Text="Mini" />
          <TextBlock Grid.Column="1" Classes="subheadline secondary" Text="Small" />
          <TextBlock Grid.Column="2" Classes="subheadline secondary" Text="Regular" />
          <TextBlock Grid.Column="3" Classes="subheadline secondary" Text="Large" />
          <TextBlock Grid.Column="4" Classes="subheadline secondary" Text="Extra Large" />

          <AutoCompleteBox Grid.Row="1" Classes="channels mini" Width="120" HorizontalAlignment="Left" VerticalAlignment="Center" Text="Games" />
          <AutoCompleteBox Grid.Row="1" Grid.Column="1" Classes="channels small" Width="120" HorizontalAlignment="Left" VerticalAlignment="Center" Text="Games" />
          <AutoCompleteBox Grid.Row="1" Grid.Column="2" Classes="channels" Width="120" HorizontalAlignment="Left" VerticalAlignment="Center" Text="Games" />
          <AutoCompleteBox Grid.Row="1" Grid.Column="3" Classes="channels large" Width="120" HorizontalAlignment="Left" VerticalAlignment="Center" Text="Games" />
          <TextBlock Grid.Row="1" Grid.Column="4" Classes="tertiary" VerticalAlignment="Center" Text="—" />
        </Grid>
      </gc:GalleryBlock>
    </gc:GallerySection>
  </gc:SectionStack>
</UserControl>
