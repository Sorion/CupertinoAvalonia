<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CupertinoAvalonia.Gallery.Views.Pages.TextFieldsPage">
  <StackPanel Spacing="28" Width="320" HorizontalAlignment="Left">
    <StackPanel Spacing="10">
      <TextBlock Classes="headline" Text="States" />
      <TextBox PlaceholderText="Placeholder" />
      <TextBox Text="Some text" />
      <TextBox Text="Disabled" IsEnabled="False" />
      <TextBox PasswordChar="•" Text="password" />
    </StackPanel>

    <StackPanel Spacing="10">
      <TextBlock Classes="headline" Text="Control sizes" />
      <TextBox Classes="mini" PlaceholderText="Mini" />
      <TextBox Classes="small" PlaceholderText="Small" />
      <TextBox PlaceholderText="Regular" />
      <TextBox Classes="large" PlaceholderText="Large" />
    </StackPanel>

    <StackPanel Spacing="10">
      <TextBlock Classes="headline" Text="Multi-line" />
      <TextBox AcceptsReturn="True" TextWrapping="Wrap" Height="90"
               Text="MixerStudio routes each application to its own channel. Type here to try the caret and the selection color." />
    </StackPanel>
  </StackPanel>
</UserControl>
