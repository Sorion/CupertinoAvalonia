<Styles x:Class="CupertinoAvalonia.CupertinoAvaloniaTheme"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cas="using:CupertinoAvalonia.Styling"
        xmlns:cac="using:CupertinoAvalonia.Controls">

  <!-- For the controls without a macOS template. The resources below are looked up first, so the macOS themes win. -->
  <FluentTheme />

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <MergeResourceInclude Source="/Styling/Tokens/Colors.g.axaml" />
        <MergeResourceInclude Source="/Styling/Tokens/Metrics.g.axaml" />
        <MergeResourceInclude Source="/Styling/Tokens/Typography.g.axaml" />
        <MergeResourceInclude Source="/Styling/Tokens/Shadows.g.axaml" />
        <MergeResourceInclude Source="/Styling/ThemeResources.axaml" />
        <MergeResourceInclude Source="/Styling/ControlThemes/ControlThemes.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <StyleInclude Source="/Styling/TextStyles.axaml" />
  <StyleInclude Source="/Styling/ListStyles.axaml" />
  <StyleInclude Source="/Styling/SearchFieldStyles.axaml" />
  <!-- After ListStyles and SearchFieldStyles: the toolbar restyles the content area's segmented control and search
       field. -->
  <StyleInclude Source="/Styling/ToolbarStyles.axaml" />

  <!-- A sidebar shows the window's material; the content stays opaque. -->
  <Style Selector="cac|CupertinoWindow:material SplitView:not(.plain):left:inline, cac|CupertinoWindow:material SplitView:not(.plain):left:compactinline">
    <Setter Property="PaneBackground" Value="Transparent" />
  </Style>
  <Style Selector="cac|CupertinoWindow:material SplitView:left /template/ Panel#ContentRoot">
    <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
  </Style>
  <Style Selector="cac|CupertinoWindow:material cac|NavigationSplitView">
    <Setter Property="SidebarBackground" Value="Transparent" />
  </Style>

  <Style Selector="Border.focus-ring[(cas|WindowActivity.IsInactive)=True]">
    <Setter Property="IsVisible" Value="False" />
  </Style>
</Styles>
