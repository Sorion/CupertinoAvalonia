<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <PackageId>CupertinoAvalonia</PackageId>
    <!-- CI sets Version from the release tag (v1.2.3 → 1.2.3). -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <Description>A macOS 27 theme for Avalonia's built-in controls, built from Apple's official macOS UI kit, with a window that has macOS's chrome.</Description>
    <Authors>Sorion</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>avalonia;theme;macos;cupertino</PackageTags>
    <PackageProjectUrl>https://github.com/Sorion/CupertinoAvalonia</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Sorion/CupertinoAvalonia</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Symbols on nuget.org's symbol server, sources through Source Link. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <!-- Skia runtime shaders for the Liquid Glass lens (GlassLens); Skia is Avalonia's default renderer. -->
    <PackageReference Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
    <!-- Fallback for controls that don't have a macOS template yet (see README). -->
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CupertinoAvalonia.Tests" />
  </ItemGroup>

  <!-- Declares macOS 26's SDK in the apps that use the package (see buildTransitive/CupertinoAvalonia.targets). -->
  <ItemGroup>
    <None Include="buildTransitive/**" Pack="true" PackagePath="buildTransitive/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
