<!--
  Search fields: a TextBox with the "search" class, as NSSearchField measured on macOS 27 (the kit's search field is
  older), and the toolbar's ("toolbar" class), whose sizes ToolbarStyles sets. Styles rather than a control theme: the
  magnifier and the clear button are the field's inner content, which a control theme can't reach.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cac="using:CupertinoAvalonia.Controls">
  <Design.PreviewWith>
    <StackPanel Margin="20" Spacing="12" Width="240">
      <TextBox Classes="search" PlaceholderText="Search" />
      <TextBox Classes="search" Text="Value" />
      <TextBox Classes="search small" Text="Small" />
    </StackPanel>
  </Design.PreviewWith>

  <Styles.Resources>
    <ResourceDictionary>
      <StreamGeometry x:Key="SearchFieldGlyph">M 11.5,6.5 A 5,5 0 1 1 1.5,6.5 A 5,5 0 1 1 11.5,6.5 Z M 10.1,10.1 L 14,14</StreamGeometry>
      <StreamGeometry x:Key="SearchClearGlyph">M 12.25,6.5 A 5.75,5.75 0 1 1 0.75,6.5 A 5.75,5.75 0 1 1 12.25,6.5 Z M 4.5,4.5 L 8.5,8.5 M 8.5,4.5 L 4.5,8.5</StreamGeometry>

      <!-- The clear button: the glyph alone, as in NSSearchField, in the placeholder's color. -->
      <ControlTheme x:Key="CupertinoSearchClearButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{Binding $parent[TextBox].PlaceholderForeground}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}" />
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pressed">
          <Setter Property="Foreground" Value="{DynamicResource LabelPrimaryBrush}" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Foreground" Value="{DynamicResource LabelTertiaryBrush}" />
        </Style>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- The magnifier, and the clear button once there's text. Sizes and margins come from the styles below. -->
  <Style Selector="TextBox.search, TextBox.toolbar">
    <Setter Property="InnerLeftContent">
      <Template>
        <cac:SymbolIcon Name="SearchGlyph"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Symbol="magnifyingglass"
                        FontWeight="Medium"
                        FallbackData="{StaticResource SearchFieldGlyph}"
                        Foreground="{Binding $parent[TextBox].PlaceholderForeground}" />
      </Template>
    </Setter>
    <Setter Property="InnerRightContent">
      <Template>
        <Button Name="SearchClearButton"
                Theme="{StaticResource CupertinoSearchClearButton}"
                Command="{Binding $parent[TextBox].Clear}"
                IsVisible="{Binding $parent[TextBox].Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                AutomationProperties.Name="Clear">
          <cac:SymbolIcon Name="SearchClearGlyph"
                          Symbol="xmark.circle.fill"
                          FallbackData="{StaticResource SearchClearGlyph}"
                          Foreground="{Binding $parent[Button].Foreground}" />
        </Button>
      </Template>
    </Setter>
  </Style>
  <Style Selector="TextBox.search cac|SymbolIcon#SearchGlyph, TextBox.toolbar cac|SymbolIcon#SearchGlyph, TextBox.search cac|SymbolIcon#SearchClearGlyph, TextBox.toolbar cac|SymbolIcon#SearchClearGlyph">
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- A capsule; the glyphs are the kit's 13 pt in regular and large, smaller below. -->
  <Style Selector="TextBox.search">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="0,0,2,0" />
    <Setter Property="PlaceholderForeground" Value="{DynamicResource LabelSecondaryBrush}" />
  </Style>
  <Style Selector="TextBox.search:disabled">
    <Setter Property="PlaceholderForeground" Value="{DynamicResource LabelTertiaryBrush}" />
  </Style>
  <Style Selector="TextBox.search cac|SymbolIcon#SearchGlyph">
    <Setter Property="Margin" Value="6,0,1,0" />
  </Style>
  <Style Selector="TextBox.search Button#SearchClearButton">
    <Setter Property="Margin" Value="2,0,4,0" />
  </Style>

  <Style Selector="TextBox.search.mini">
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="TextBox.search.mini cac|SymbolIcon#SearchGlyph">
    <Setter Property="FontSize" Value="9" />
    <Setter Property="Margin" Value="3.5,0,1.5,0" />
  </Style>
  <Style Selector="TextBox.search.mini cac|SymbolIcon#SearchClearGlyph">
    <Setter Property="FontSize" Value="9" />
  </Style>
  <Style Selector="TextBox.search.mini Button#SearchClearButton">
    <Setter Property="Margin" Value="2,0,2,0" />
  </Style>

  <Style Selector="TextBox.search.small">
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="TextBox.search.small cac|SymbolIcon#SearchGlyph">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Margin" Value="4,0,0.5,0" />
  </Style>
  <Style Selector="TextBox.search.small cac|SymbolIcon#SearchClearGlyph">
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="TextBox.search.small Button#SearchClearButton">
    <Setter Property="Margin" Value="2,0,3,0" />
  </Style>

  <Style Selector="TextBox.search.large">
    <Setter Property="CornerRadius" Value="14" />
  </Style>
  <Style Selector="TextBox.search.large cac|SymbolIcon#SearchGlyph">
    <Setter Property="Margin" Value="8,0,3,0" />
  </Style>
  <Style Selector="TextBox.search.large Button#SearchClearButton">
    <Setter Property="Margin" Value="2,0,6,0" />
  </Style>
</Styles>
