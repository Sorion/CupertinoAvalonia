<!--
  ToggleSwitch, from the kit's "Toggles - Switches" (page Toggles). macOS shows no On/Off text: Content is the label
  before the switch.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:cas="using:CupertinoAvalonia.Styling">
  <Design.PreviewWith>
    <StackPanel Margin="20" Spacing="10">
      <ToggleSwitch IsChecked="True" />
      <ToggleSwitch />
      <ToggleSwitch Content="Launch at login" IsChecked="True" />
      <ToggleSwitch IsChecked="True" IsEnabled="False" />
      <ToggleSwitch Classes="small" IsChecked="True" />
      <ToggleSwitch Classes="mini" IsChecked="True" />
    </StackPanel>
  </Design.PreviewWith>

  <ResourceDictionary.ThemeDictionaries>
    <!-- The pressed lens, measured on macOS 27 (System Settings): the kit's "_Knob Clicked" predates it. -->
    <ResourceDictionary x:Key="Default">
      <Color x:Key="SwitchLensHighlightColor">#6BFFFFFF</Color>
      <x:Double x:Key="SwitchLensIridescence">0.16</x:Double>
      <BoxShadows x:Key="SwitchLensShadow">0 6 6 -2.5 #17000000, 0 0.8 0.3 0 #26000000</BoxShadows>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="SwitchLensHighlightColor">#3DFFFFFF</Color>
      <x:Double x:Key="SwitchLensIridescence">0.07</x:Double>
      <BoxShadows x:Key="SwitchLensShadow">0 6 6 -2.5 #12000000</BoxShadows>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!--
    The pressed lens ("_Knob Clicked"), 1.62 times the knob: the kit's glass overflows a 50 × 31 component on the
    32 × 20 knob. Its sizes are before that scale.
  -->
  <ControlTheme x:Key="CupertinoSwitchLens" TargetType="TemplatedControl">
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <!-- As on macOS 27: clear glass that zooms the track out. -->
          <cas:GlassLens Name="PART_Glass"
                         Magnification="0.74"
                         Refraction="0"
                         Frost="0"
                         Dispersion="0.04"
                         Tint="#0B000000"
                         HighlightColor="{DynamicResource SwitchLensHighlightColor}"
                         HighlightFalloff="3.7"
                         RimColor="{DynamicResource GlassLensRimColor}"
                         RimWidth="0.85"
                         Iridescence="{DynamicResource SwitchLensIridescence}"
                         FallbackBackground="{DynamicResource WindowBackgroundBrush}"
                         FallbackForeground="{DynamicResource ControlTrackPressedBrush}" />
          <!-- After the glass, so the glass doesn't refract it. Shadow offsets ignore render transforms: they are
               screen DIPs, while blur and spread scale with the lens. -->
          <Border CornerRadius="100"
                  Background="Transparent"
                  BoxShadow="{DynamicResource SwitchLensShadow}" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^.on /template/ cas|GlassLens#PART_Glass">
      <Setter Property="FallbackForeground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <!-- Keyframes can't animate RenderTransform itself, only a ScaleTransform they create. -->
    <Style Selector="^">
      <Style.Animations>
        <Animation Duration="0:0:0.2" Easing="BackEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="ScaleTransform.ScaleX" Value="1" />
            <Setter Property="ScaleTransform.ScaleY" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="ScaleTransform.ScaleX" Value="1.62" />
            <Setter Property="ScaleTransform.ScaleY" Value="1.62" />
          </KeyFrame>
        </Animation>
        <Animation Duration="0:0:0.12" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ToggleSwitch}" TargetType="ToggleSwitch">
    <!-- Would clip the knob's shadow. -->
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Foreground" Value="{DynamicResource LabelPrimaryBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource ControlFontWeight}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="KnobTransitions">
      <Transitions>
        <DoubleTransition Property="Canvas.Left" Duration="0:0:0.2" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="Auto,Auto" Background="{TemplateBinding Background}">
          <ContentPresenter Name="PART_ContentPresenter"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            RecognizesAccessKey="True" />
          <!-- Parts ToggleSwitch expects. -->
          <ContentPresenter Name="PART_OffContentPresenter" IsVisible="False"
                            Content="{TemplateBinding OffContent}"
                            ContentTemplate="{TemplateBinding OffContentTemplate}" />
          <ContentPresenter Name="PART_OnContentPresenter" IsVisible="False"
                            Content="{TemplateBinding OnContent}"
                            ContentTemplate="{TemplateBinding OnContentTemplate}" />

          <Panel Name="PART_Track"
                 Grid.Column="1"
                 Width="{DynamicResource SwitchTrackWidth}"
                 Height="{DynamicResource SwitchTrackHeight}"
                 VerticalAlignment="Center">
            <!-- _Tracks - Unfilled -->
            <Border Name="PART_TrackOff" CornerRadius="100"
                    Background="{DynamicResource LabelPrimaryBrush}" Opacity="0.1" />
            <Border Name="PART_TrackOn" CornerRadius="100"
                    Background="{DynamicResource AccentBrush}" Opacity="0" />
            <Border Name="PART_TrackPressed" CornerRadius="100"
                    Background="{DynamicResource FillSecondaryBrush}" IsVisible="False" />
            <Canvas Name="PART_SwitchKnob"
                    Width="{DynamicResource SwitchKnobTravel}"
                    Height="{DynamicResource SwitchKnobHeight}"
                    Margin="{DynamicResource SwitchKnobMargin}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
              <Panel Name="PART_MovingKnobs"
                     Width="{DynamicResource SwitchKnobWidth}"
                     Height="{DynamicResource SwitchKnobHeight}">
                <!-- _Knob -->
                <Border Name="PART_Knob"
                        CornerRadius="100"
                        Background="{DynamicResource WhiteBrush}"
                        BoxShadow="0 3 36 0 #0D000000, 0 0 1 0 #26000000">
                  <Border.Transitions>
                    <Transitions>
                      <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                    </Transitions>
                  </Border.Transitions>
                </Border>
              </Panel>
            </Canvas>
          </Panel>
        </Grid>
      </ControlTemplate>
    </Setter>

    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter:empty">
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="^:focus-visible /template/ Panel#PART_Track">
      <Setter Property="AdornerLayer.Adorner">
        <Template>
          <Panel AdornerLayer.IsClipEnabled="False" IsHitTestVisible="False">
            <Border Classes="focus-ring" cas:OverflowAdorner.FollowAdorned="True" CornerRadius="100" BoxShadow="{DynamicResource FocusRingShadow}" />
          </Panel>
        </Template>
      </Setter>
    </Style>

    <Style Selector="^:checked">
      <Style Selector="^ /template/ Border#PART_TrackOn">
        <Setter Property="Opacity" Value="1" />
      </Style>
      <Style Selector="^ /template/ Border#PART_TrackOff">
        <Setter Property="Opacity" Value="0" />
      </Style>
      <Style Selector="^:pressed /template/ Border#PART_TrackPressed">
        <Setter Property="IsVisible" Value="True" />
      </Style>
    </Style>

    <Style Selector="^[(cas|WindowActivity.IsInactive)=True]:checked /template/ Border#PART_TrackOn">
      <Setter Property="Background" Value="{DynamicResource ControlFillInactiveBrush}" />
    </Style>

    <Style Selector="^:pressed:unchecked /template/ Border#PART_TrackOff">
      <Setter Property="Opacity" Value="0.19" />
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_Knob, ^:dragging /template/ Border#PART_Knob">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="^:pressed:unchecked /template/ Panel#PART_MovingKnobs, ^:dragging:unchecked /template/ Panel#PART_MovingKnobs">
      <Setter Property="AdornerLayer.Adorner">
        <Template>
          <Panel AdornerLayer.IsClipEnabled="False" IsHitTestVisible="False">
            <TemplatedControl Theme="{DynamicResource CupertinoSwitchLens}" />
          </Panel>
        </Template>
      </Setter>
    </Style>
    <Style Selector="^:pressed:checked /template/ Panel#PART_MovingKnobs, ^:dragging:checked /template/ Panel#PART_MovingKnobs">
      <Setter Property="AdornerLayer.Adorner">
        <Template>
          <Panel AdornerLayer.IsClipEnabled="False" IsHitTestVisible="False">
            <TemplatedControl Classes="on" Theme="{DynamicResource CupertinoSwitchLens}" />
          </Panel>
        </Template>
      </Setter>
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource LabelTertiaryBrush}" />
      <Style Selector="^:unchecked /template/ Border#PART_TrackOff">
        <Setter Property="Opacity" Value="0.06" />
      </Style>
      <!-- The kit doesn't dim it; AppKit does. -->
      <Style Selector="^:checked /template/ Border#PART_TrackOn">
        <Setter Property="Opacity" Value="0.5" />
      </Style>
    </Style>

    <Style Selector="^.mini">
      <Setter Property="FontSize" Value="{DynamicResource ControlFontSizeMini}" />
      <Setter Property="LetterSpacing" Value="{DynamicResource ControlLetterSpacingMini}" />
      <Style Selector="^ /template/ Panel#PART_Track">
        <Setter Property="Width" Value="{DynamicResource SwitchTrackWidthMini}" />
        <Setter Property="Height" Value="{DynamicResource SwitchTrackHeightMini}" />
      </Style>
      <Style Selector="^ /template/ Canvas#PART_SwitchKnob">
        <Setter Property="Width" Value="{DynamicResource SwitchKnobTravelMini}" />
        <Setter Property="Height" Value="{DynamicResource SwitchKnobHeightMini}" />
        <Setter Property="Margin" Value="{DynamicResource SwitchKnobMarginMini}" />
      </Style>
      <Style Selector="^ /template/ Panel#PART_MovingKnobs">
        <Setter Property="Width" Value="{DynamicResource SwitchKnobWidthMini}" />
        <Setter Property="Height" Value="{DynamicResource SwitchKnobHeightMini}" />
      </Style>
    </Style>
    <Style Selector="^.small">
      <Setter Property="FontSize" Value="{DynamicResource ControlFontSizeSmall}" />
      <Setter Property="LetterSpacing" Value="{DynamicResource ControlLetterSpacingSmall}" />
      <Style Selector="^ /template/ Panel#PART_Track">
        <Setter Property="Width" Value="{DynamicResource SwitchTrackWidthSmall}" />
        <Setter Property="Height" Value="{DynamicResource SwitchTrackHeightSmall}" />
      </Style>
      <Style Selector="^ /template/ Canvas#PART_SwitchKnob">
        <Setter Property="Width" Value="{DynamicResource SwitchKnobTravelSmall}" />
        <Setter Property="Height" Value="{DynamicResource SwitchKnobHeightSmall}" />
        <Setter Property="Margin" Value="{DynamicResource SwitchKnobMarginSmall}" />
      </Style>
      <Style Selector="^ /template/ Panel#PART_MovingKnobs">
        <Setter Property="Width" Value="{DynamicResource SwitchKnobWidthSmall}" />
        <Setter Property="Height" Value="{DynamicResource SwitchKnobHeightSmall}" />
      </Style>
    </Style>
    <Style Selector="^.large">
      <Setter Property="FontSize" Value="{DynamicResource ControlFontSizeLarge}" />
      <Style Selector="^ /template/ Panel#PART_Track">
        <Setter Property="Width" Value="{DynamicResource SwitchTrackWidthLarge}" />
        <Setter Property="Height" Value="{DynamicResource SwitchTrackHeightLarge}" />
      </Style>
      <Style Selector="^ /template/ Canvas#PART_SwitchKnob">
        <Setter Property="Width" Value="{DynamicResource SwitchKnobTravelLarge}" />
        <Setter Property="Height" Value="{DynamicResource SwitchKnobHeightLarge}" />
        <Setter Property="Margin" Value="{DynamicResource SwitchKnobMarginLarge}" />
      </Style>
      <Style Selector="^ /template/ Panel#PART_MovingKnobs">
        <Setter Property="Width" Value="{DynamicResource SwitchKnobWidthLarge}" />
        <Setter Property="Height" Value="{DynamicResource SwitchKnobHeightLarge}" />
      </Style>
    </Style>
  </ControlTheme>
</ResourceDictionary>
