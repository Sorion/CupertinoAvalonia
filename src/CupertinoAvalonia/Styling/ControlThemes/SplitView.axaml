<!--
  SplitView, from the kit's "Windows - Composed" (page Windows): a sidebar on the left, an inspector on the right (the
  kit has none: sized after native apps). Avalonia's Fluent templates, restyled.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System"
                    xmlns:cas="using:CupertinoAvalonia.Styling">
  <Design.PreviewWith>
    <Border Width="600" Height="300">
      <SplitView DisplayMode="Inline" IsPaneOpen="True">
        <SplitView.Pane>
          <TextBlock Margin="16" Text="Sidebar" />
        </SplitView.Pane>
        <TextBlock Margin="16" Text="Content" />
      </SplitView>
    </Border>
  </Design.PreviewWith>

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Default">
      <!-- A sidebar or inspector where no material shows, measured on macOS 27 with wallpaper tinting off. -->
      <Color x:Key="SplitViewPaneBackgroundColor">#EDEDED</Color>
      <SolidColorBrush x:Key="SplitViewSidebarBackgroundBrush" Color="{DynamicResource SplitViewPaneBackgroundColor}" />
      <SolidColorBrush x:Key="SplitViewInspectorBackgroundBrush" Color="{DynamicResource SplitViewPaneBackgroundColor}" />
      <!-- Table Column Separator -->
      <SolidColorBrush x:Key="SplitViewDividerBrush" Color="{DynamicResource TableColumnSeparatorColor}" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="SplitViewPaneBackgroundColor">#252525</Color>
      <SolidColorBrush x:Key="SplitViewSidebarBackgroundBrush" Color="{DynamicResource SplitViewPaneBackgroundColor}" />
      <SolidColorBrush x:Key="SplitViewInspectorBackgroundBrush" Color="{DynamicResource SplitViewPaneBackgroundColor}" />
      <SolidColorBrush x:Key="SplitViewDividerBrush" Color="{DynamicResource TableColumnSeparatorColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <x:Double x:Key="SplitViewDividerThickness">1</x:Double>
  <x:Double x:Key="SplitViewSidebarLength">240</x:Double>
  <x:Double x:Key="SplitViewInspectorLength">280</x:Double>
  <x:Double x:Key="SplitViewCompactPaneLength">52</x:Double>
  <sys:TimeSpan x:Key="SplitViewPaneDuration">00:00:00.25</sys:TimeSpan>
  <!-- Not a spline easing: it stops short of its end in Avalonia 12. -->
  <SineEaseInOut x:Key="SplitViewPaneEasing" />

  <ControlTheme x:Key="{x:Type SplitView}" TargetType="SplitView">
    <Setter Property="OpenPaneLength" Value="{DynamicResource SplitViewSidebarLength}" />
    <Setter Property="CompactPaneLength" Value="{DynamicResource SplitViewCompactPaneLength}" />
    <Setter Property="PaneBackground" Value="{DynamicResource SplitViewSidebarBackgroundBrush}" />

    <!-- Set whatever the state: set with the new width, they would come too late. -->
    <Style Selector="^ /template/ Panel#PART_PaneRoot">
      <Setter Property="Transitions">
        <Transitions>
          <cas:LengthTransition Property="Width" Duration="{StaticResource SplitViewPaneDuration}" Easing="{StaticResource SplitViewPaneEasing}" />
          <cas:LengthTransition Property="Height" Duration="{StaticResource SplitViewPaneDuration}" Easing="{StaticResource SplitViewPaneEasing}" />
        </Transitions>
      </Setter>
    </Style>

    <!-- PART_PaneRoot clips the pane while it animates. -->
    <Style Selector="^:left">
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Name="Container" Background="{TemplateBinding Background}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.PaneColumnGridLength}" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Panel Name="PART_PaneRoot" ClipToBounds="True" HorizontalAlignment="Left" ZIndex="100">
              <Border Name="PaneUnderlay" Background="{DynamicResource WindowBackgroundBrush}" IsVisible="False" />
              <Border Name="PaneBackground" Background="{TemplateBinding PaneBackground}" />
              <ContentPresenter Name="PART_PanePresenter"
                                Content="{TemplateBinding Pane}"
                                ContentTemplate="{TemplateBinding PaneTemplate}" />
              <Rectangle Name="PaneDivider" Fill="{DynamicResource SplitViewDividerBrush}" Width="{DynamicResource SplitViewDividerThickness}" HorizontalAlignment="Right" />
            </Panel>
            <Panel Name="ContentRoot" Grid.Column="1">
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
              <Rectangle Name="LightDismissLayer" Fill="Transparent" IsVisible="False" />
            </Panel>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:overlay, ^:compactoverlay">
        <Style Selector="^ /template/ Panel#PART_PaneRoot">
          <Setter Property="Grid.Column" Value="0" />
          <Setter Property="Grid.ColumnSpan" Value="2" />
        </Style>
      </Style>
      <Style Selector="^:overlay /template/ Panel#ContentRoot">
        <Setter Property="Grid.Column" Value="0" />
        <Setter Property="Grid.ColumnSpan" Value="2" />
      </Style>
      <Style Selector="^:open /template/ Panel#PART_PaneRoot">
        <Setter Property="Width" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=OpenPaneLength}" />
      </Style>
      <Style Selector="^:closed /template/ Panel#PART_PaneRoot">
        <Setter Property="Width" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.ClosedPaneWidth}" />
      </Style>
    </Style>

    <Style Selector="^:right">
      <Setter Property="OpenPaneLength" Value="{DynamicResource SplitViewInspectorLength}" />
      <Setter Property="PaneBackground" Value="{DynamicResource SplitViewInspectorBackgroundBrush}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Name="Container" Background="{TemplateBinding Background}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.PaneColumnGridLength}" />
            </Grid.ColumnDefinitions>
            <Panel Name="PART_PaneRoot" Grid.Column="1" ClipToBounds="True" HorizontalAlignment="Right" ZIndex="100">
              <Border Name="PaneUnderlay" Background="{DynamicResource WindowBackgroundBrush}" IsVisible="False" />
              <Border Name="PaneBackground" Background="{TemplateBinding PaneBackground}" />
              <ContentPresenter Name="PART_PanePresenter"
                                Content="{TemplateBinding Pane}"
                                ContentTemplate="{TemplateBinding PaneTemplate}" />
              <Rectangle Name="PaneDivider" Fill="{DynamicResource SplitViewDividerBrush}" Width="{DynamicResource SplitViewDividerThickness}" HorizontalAlignment="Left" />
            </Panel>
            <Panel Name="ContentRoot">
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
              <Rectangle Name="LightDismissLayer" Fill="Transparent" IsVisible="False" />
            </Panel>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:overlay, ^:compactoverlay">
        <Style Selector="^ /template/ Panel#PART_PaneRoot">
          <Setter Property="Grid.Column" Value="0" />
          <Setter Property="Grid.ColumnSpan" Value="2" />
        </Style>
      </Style>
      <Style Selector="^:overlay /template/ Panel#ContentRoot">
        <Setter Property="Grid.ColumnSpan" Value="2" />
      </Style>
      <Style Selector="^:open /template/ Panel#PART_PaneRoot">
        <Setter Property="Width" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=OpenPaneLength}" />
      </Style>
      <Style Selector="^:closed /template/ Panel#PART_PaneRoot">
        <Setter Property="Width" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.ClosedPaneWidth}" />
      </Style>
    </Style>

    <Style Selector="^:top">
      <Setter Property="PaneBackground" Value="{DynamicResource WindowBackgroundBrush}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Name="Container" Background="{TemplateBinding Background}">
            <Grid.RowDefinitions>
              <RowDefinition Height="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.PaneRowGridLength}" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Panel Name="PART_PaneRoot" ClipToBounds="True" VerticalAlignment="Top" ZIndex="100">
              <Border Name="PaneUnderlay" Background="{DynamicResource WindowBackgroundBrush}" IsVisible="False" />
              <Border Name="PaneBackground" Background="{TemplateBinding PaneBackground}" />
              <ContentPresenter Name="PART_PanePresenter"
                                Content="{TemplateBinding Pane}"
                                ContentTemplate="{TemplateBinding PaneTemplate}" />
              <Rectangle Name="PaneDivider" Fill="{DynamicResource SplitViewDividerBrush}" Height="{DynamicResource SplitViewDividerThickness}" VerticalAlignment="Bottom" />
            </Panel>
            <Panel Name="ContentRoot" Grid.Row="1">
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
              <Rectangle Name="LightDismissLayer" Fill="Transparent" IsVisible="False" />
            </Panel>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:overlay, ^:compactoverlay">
        <Style Selector="^ /template/ Panel#PART_PaneRoot">
          <Setter Property="Grid.Row" Value="0" />
          <Setter Property="Grid.RowSpan" Value="2" />
        </Style>
      </Style>
      <Style Selector="^:overlay /template/ Panel#ContentRoot">
        <Setter Property="Grid.Row" Value="0" />
        <Setter Property="Grid.RowSpan" Value="2" />
      </Style>
      <Style Selector="^:open /template/ Panel#PART_PaneRoot">
        <Setter Property="Height" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=OpenPaneLength}" />
      </Style>
      <Style Selector="^:closed /template/ Panel#PART_PaneRoot">
        <Setter Property="Height" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.ClosedPaneHeight}" />
      </Style>
    </Style>

    <Style Selector="^:bottom">
      <Setter Property="PaneBackground" Value="{DynamicResource WindowBackgroundBrush}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Name="Container" Background="{TemplateBinding Background}">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.PaneRowGridLength}" />
            </Grid.RowDefinitions>
            <Panel Name="PART_PaneRoot" Grid.Row="1" ClipToBounds="True" VerticalAlignment="Bottom" ZIndex="100">
              <Border Name="PaneUnderlay" Background="{DynamicResource WindowBackgroundBrush}" IsVisible="False" />
              <Border Name="PaneBackground" Background="{TemplateBinding PaneBackground}" />
              <ContentPresenter Name="PART_PanePresenter"
                                Content="{TemplateBinding Pane}"
                                ContentTemplate="{TemplateBinding PaneTemplate}" />
              <Rectangle Name="PaneDivider" Fill="{DynamicResource SplitViewDividerBrush}" Height="{DynamicResource SplitViewDividerThickness}" VerticalAlignment="Top" />
            </Panel>
            <Panel Name="ContentRoot">
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
              <Rectangle Name="LightDismissLayer" Fill="Transparent" IsVisible="False" />
            </Panel>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:overlay, ^:compactoverlay">
        <Style Selector="^ /template/ Panel#PART_PaneRoot">
          <Setter Property="Grid.Row" Value="0" />
          <Setter Property="Grid.RowSpan" Value="2" />
        </Style>
      </Style>
      <Style Selector="^:overlay /template/ Panel#ContentRoot">
        <Setter Property="Grid.RowSpan" Value="2" />
      </Style>
      <Style Selector="^:open /template/ Panel#PART_PaneRoot">
        <Setter Property="Height" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=OpenPaneLength}" />
      </Style>
      <Style Selector="^:closed /template/ Panel#PART_PaneRoot">
        <Setter Property="Height" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.ClosedPaneHeight}" />
      </Style>
    </Style>

    <!-- As in macOS 27, a side pane of its own color has no divider; "plain" puts it on the content's background,
         set apart by a divider, as in Shortcuts. -->
    <Style Selector="^:left /template/ Rectangle#PaneDivider, ^:right /template/ Rectangle#PaneDivider">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^.plain">
      <Setter Property="PaneBackground" Value="{DynamicResource WindowBackgroundBrush}" />
      <Style Selector="^ /template/ Rectangle#PaneDivider">
        <Setter Property="IsVisible" Value="True" />
      </Style>
    </Style>

    <!-- Opaque over the content, which macOS doesn't dim. -->
    <Style Selector="^:overlay:open, ^:compactoverlay:open">
      <Style Selector="^ /template/ Border#PaneUnderlay">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^ /template/ Rectangle#LightDismissLayer">
        <Setter Property="IsVisible" Value="True" />
      </Style>
    </Style>
    <Style Selector="^:closed:inline /template/ Rectangle#PaneDivider, ^:closed:overlay /template/ Rectangle#PaneDivider">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
