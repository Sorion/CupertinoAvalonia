<!--
  NavigationSplitView, after SwiftUI's on macOS 27 (measured in TestNav): the sidebar slides out over the window's full
  height and the content follows its edge, in SplitView's 0.25 s; the sidebar button sits over the sidebar. The
  inspector, after SwiftUI's: the sidebar's material, no divider, the content's toolbar over it.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:cac="using:CupertinoAvalonia.Controls">

  <!-- SwiftUI's ideal sidebar width. -->
  <x:Double x:Key="NavigationSplitViewSidebarWidth">220</x:Double>

  <!-- The sidebar button's label, as its tooltip and accessibility name, by the sidebar's state: AppKit's (macOS 27). An
       app redefines them in its own resources, in its language. -->
  <x:String x:Key="NavigationSplitViewHideSidebarText">Hide Sidebar</x:String>
  <x:String x:Key="NavigationSplitViewShowSidebarText">Show Sidebar</x:String>

  <ControlTheme x:Key="{x:Type cac:NavigationSplitView}" TargetType="cac:NavigationSplitView">
    <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
    <Setter Property="SidebarBackground" Value="{DynamicResource SplitViewSidebarBackgroundBrush}" />
    <Setter Property="SidebarWidth" Value="{DynamicResource NavigationSplitViewSidebarWidth}" />
    <Setter Property="InspectorBackground" Value="{DynamicResource SplitViewInspectorBackgroundBrush}" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="VisibleSidebarWidth" Duration="{StaticResource SplitViewPaneDuration}" Easing="{StaticResource SplitViewPaneEasing}" />
        <DoubleTransition Property="VisibleInspectorWidth" Duration="{StaticResource SplitViewPaneDuration}" Easing="{StaticResource SplitViewPaneEasing}" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <!-- The inspector, the window's full height, under the content's toolbar: it slides in from the right. Its top
               drags the window. -->
          <Panel Name="PART_InspectorRoot" Width="{TemplateBinding InspectorWidth}" HorizontalAlignment="Right">
            <Border Background="{TemplateBinding InspectorBackground}" />
            <Border Height="{Binding #PART_ToggleBand.Height}"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    WindowDecorationProperties.ElementRole="TitleBar" />
            <ContentPresenter Name="PART_InspectorPresenter" Content="{TemplateBinding Inspector}" />
          </Panel>

          <!-- From the sidebar's edge: the content, to the inspector's edge, and its toolbar over its top, whose items run
               to the window's edge, over the inspector. -->
          <Panel Name="PART_ContentRoot">
            <ContentPresenter Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            <!-- The inspector's edge, which a drag moves: under the toolbar's items. -->
            <Border Name="PART_InspectorGrip" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWestEast" />
            <!-- The content's section, then the inspector's, which follows the inspector's edge. -->
            <cac:CupertinoToolbar Name="PART_Toolbar">
              <cac:ToolbarSections>
                <ContentPresenter Name="PART_ContentToolbarPresenter"
                                  VerticalAlignment="Center"
                                  Content="{TemplateBinding ContentToolbar}" />
                <ContentPresenter Name="PART_InspectorToolbarPresenter"
                                  VerticalAlignment="Center"
                                  Content="{TemplateBinding InspectorToolbar}" />
              </cac:ToolbarSections>
            </cac:CupertinoToolbar>
          </Panel>

          <!-- The sidebar, the window's full height: it slides out. Its top drags the window. -->
          <Panel Name="PART_SidebarRoot" Width="{TemplateBinding SidebarWidth}" HorizontalAlignment="Left">
            <Border Background="{TemplateBinding SidebarBackground}" />
            <Border Height="{Binding #PART_ToggleBand.Height}"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    WindowDecorationProperties.ElementRole="TitleBar" />
            <ContentPresenter Name="PART_SidebarPresenter" Content="{TemplateBinding Sidebar}" />
          </Panel>

          <!-- The sidebar's edge, which a drag moves. -->
          <Border Name="PART_SidebarGrip" HorizontalAlignment="Left" Background="Transparent" Cursor="SizeWestEast" />

          <!-- The sidebar button, over both, centered in the toolbar's height. -->
          <Panel Name="PART_ToggleBand" VerticalAlignment="Top">
            <Button Name="PART_SidebarToggle"
                    Classes="toolbar"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
              <cac:SymbolIcon Symbol="sidebar.left" />
            </Button>
          </Panel>
        </Panel>
      </ControlTemplate>
    </Setter>

    <!-- Set by styles: a value in the template would block them. -->
    <Style Selector="^ /template/ Button#PART_SidebarToggle">
      <Setter Property="ToolTip.Tip" Value="{DynamicResource NavigationSplitViewHideSidebarText}" />
      <Setter Property="AutomationProperties.Name" Value="{DynamicResource NavigationSplitViewHideSidebarText}" />
    </Style>
    <Style Selector="^[IsSidebarOpen=False] /template/ Button#PART_SidebarToggle">
      <Setter Property="ToolTip.Tip" Value="{DynamicResource NavigationSplitViewShowSidebarText}" />
      <Setter Property="AutomationProperties.Name" Value="{DynamicResource NavigationSplitViewShowSidebarText}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
