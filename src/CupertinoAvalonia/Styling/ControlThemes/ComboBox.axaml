<!--
  ComboBox as a pop-up button, from the kit's "Pop-Up Button" (page Pop-up and Pull-down Buttons). Its chevron is
  NSPopUpButton's, measured on macOS 27: chevron.up.chevron.down (Medium) 35.75 pt after the label, its ink centered 13.75
  pt from the end. A 10 pt box holds it; the symbol's ink sits 0.25 pt left of the box's center.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:cas="using:CupertinoAvalonia.Styling"
                    xmlns:cac="using:CupertinoAvalonia.Controls">
  <Design.PreviewWith>
    <StackPanel Margin="20" Spacing="10">
      <ComboBox SelectedIndex="0">
        <ComboBoxItem Content="Automatic" />
        <ComboBoxItem Content="Light" />
        <ComboBoxItem Content="Dark" />
      </ComboBox>
      <ComboBox PlaceholderText="Choose…" />
      <ComboBox SelectedIndex="0" IsEnabled="False">
        <ComboBoxItem Content="Disabled" />
      </ComboBox>
    </StackPanel>
  </Design.PreviewWith>

  <StreamGeometry x:Key="ComboBoxItemCheckGlyph">M 0.9,4.6 L 3.6,7.6 L 8.4,1.2</StreamGeometry>
  <StreamGeometry x:Key="PopUpButtonChevron">M 0.75,3.75 L 3.5,1 L 6.25,3.75 M 0.75,7.25 L 3.5,10 L 6.25,7.25</StreamGeometry>
  <StreamGeometry x:Key="ComboBoxArrowChevron">M 0.75,0.75 L 4,4 L 7.25,0.75</StreamGeometry>

  <ControlTheme x:Key="{x:Type ComboBox}" TargetType="ComboBox">
    <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LabelPrimaryBrush}" />
    <Setter Property="PlaceholderForeground" Value="{DynamicResource LabelTertiaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource ButtonRadius}" />
    <Setter Property="Padding" Value="{DynamicResource PopUpButtonPadding}" />
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
    <Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource ControlFontWeight}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="MaxDropDownHeight" Value="504" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="Template">
      <ControlTemplate>
        <DataValidationErrors>
          <Grid ColumnDefinitions="*,Auto">
            <Border Name="Background"
                    Grid.ColumnSpan="2"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <TextBlock Name="PlaceholderTextBlock"
                       Margin="{TemplateBinding Padding}"
                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                       Text="{TemplateBinding PlaceholderText}"
                       Foreground="{TemplateBinding PlaceholderForeground}">
              <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="SelectionBoxItem" RelativeSource="{RelativeSource TemplatedParent}" Converter="{x:Static ObjectConverters.IsNull}" />
                  <Binding Path="!IsEditable" RelativeSource="{RelativeSource TemplatedParent}" />
                </MultiBinding>
              </TextBlock.IsVisible>
            </TextBlock>
            <ContentControl Name="ContentPresenter"
                            Margin="{TemplateBinding Padding}"
                            Content="{TemplateBinding SelectionBoxItem}"
                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            IsVisible="{TemplateBinding IsEditable, Converter={x:Static BoolConverters.Not}}" />
            <TextBox Name="PART_EditableTextBox"
                     Grid.ColumnSpan="2"
                     Classes="embedded"
                     Padding="{TemplateBinding Padding}"
                     FontSize="{TemplateBinding FontSize}"
                     LetterSpacing="{TemplateBinding LetterSpacing}"
                     MinHeight="0"
                     VerticalAlignment="Stretch"
                     Foreground="{TemplateBinding Foreground}"
                     Text="{TemplateBinding Text, Mode=TwoWay}"
                     PlaceholderText="{TemplateBinding PlaceholderText}"
                     IsVisible="{TemplateBinding IsEditable}">
              <!-- The combo box draws the field. -->
              <TextBox.Resources>
                <SolidColorBrush x:Key="TextFieldBackgroundBrush" Color="Transparent" />
                <SolidColorBrush x:Key="TextFieldBorderBrush" Color="Transparent" />
              </TextBox.Resources>
            </TextBox>
            <cac:SymbolIcon Name="DropDownGlyph"
                            Grid.Column="1"
                            Width="10"
                            Margin="17.25,0,8.5,0"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Symbol="chevron.up.chevron.down"
                            FontSize="10.75"
                            FontWeight="Medium"
                            FallbackData="{StaticResource PopUpButtonChevron}"
                            FallbackStrokeThickness="1.6"
                            Foreground="{TemplateBinding Foreground}"
                            IsVisible="{TemplateBinding IsEditable, Converter={x:Static BoolConverters.Not}}" />
            <!-- Editable: the kit's "Combo Box Button", over the field's text inset; a press there opens the list. The
                 chevron is NSComboBox's (Bold), its ink 0.25 pt above the center, which the margins offset. -->
            <Border Name="ArrowButton"
                    Grid.Column="1"
                    Width="23.5"
                    Height="17.5"
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    CornerRadius="{DynamicResource ComboBoxRadiusButton}"
                    Background="{DynamicResource ButtonBackgroundBrush}"
                    IsVisible="{TemplateBinding IsEditable}">
              <cac:SymbolIcon Name="ArrowGlyph"
                              Margin="0.5,0,0,1"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Symbol="chevron.down"
                              FontSize="8.25"
                              FontWeight="Bold"
                              FallbackData="{StaticResource ComboBoxArrowChevron}"
                              FallbackStrokeThickness="1.6"
                              Foreground="{TemplateBinding Foreground}" />
            </Border>
            <Popup Name="PART_Popup"
                   WindowManagerAddShadowHint="False"
                   IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                   MaxHeight="{TemplateBinding MaxDropDownHeight}"
                   PlacementTarget="Background"
                   Placement="Bottom"
                   HorizontalOffset="0"
                   VerticalOffset="-4"
                   IsLightDismissEnabled="True"
                   InheritsTransform="True">
              <Border Name="PopupBorder"
                      Margin="{DynamicResource PopupShadowMargin}"
                      MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                      Background="{DynamicResource MenuBackgroundBrush}"
                      BorderBrush="{DynamicResource MenuBorderBrush}"
                      BorderThickness="0.5"
                      CornerRadius="{DynamicResource MenuCornerRadius}"
                      BoxShadow="{DynamicResource PopupShadow}">
                <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                              VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                              IsScrollChainingEnabled="False">
                  <ItemsPresenter Name="PART_ItemsPresenter"
                                  Margin="5"
                                  ItemsPanel="{TemplateBinding ItemsPanel}" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </DataValidationErrors>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:focus-visible /template/ Border#Background, ^[IsEditable=True]:focus-within /template/ Border#Background">
      <Setter Property="AdornerLayer.Adorner">
        <Template>
          <Panel AdornerLayer.IsClipEnabled="False" IsHitTestVisible="False">
            <Border Classes="focus-ring" cas:OverflowAdorner.FollowAdorned="True" BoxShadow="{DynamicResource FocusRingShadow}" />
          </Panel>
        </Template>
      </Setter>
    </Style>
    <Style Selector="^:pressed, ^:dropdownopen">
      <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPressedBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Background" Value="{DynamicResource ButtonBackgroundDisabledBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource LabelTertiaryBrush}" />
    </Style>

    <!-- Mini and small: the ink 0.5 pt below the center, which the bottom margin offsets. -->
    <Style Selector="^.mini /template/ cac|SymbolIcon#DropDownGlyph">
      <Setter Property="Margin" Value="9.75,0,4,1" />
      <Setter Property="FontSize" Value="9.25" />
    </Style>
    <Style Selector="^.mini">
      <Setter Property="MinHeight" Value="{DynamicResource ControlHeightMini}" />
      <Setter Property="Padding" Value="{DynamicResource PopUpButtonPaddingMini}" />
      <Setter Property="CornerRadius" Value="{DynamicResource ButtonRadiusMini}" />
      <Setter Property="FontSize" Value="{DynamicResource ControlFontSizeMini}" />
      <Setter Property="LetterSpacing" Value="{DynamicResource ControlLetterSpacingMini}" />
    </Style>
    <Style Selector="^.small /template/ cac|SymbolIcon#DropDownGlyph">
      <Setter Property="Margin" Value="13.75,0,6,1" />
      <Setter Property="FontSize" Value="9.25" />
    </Style>
    <Style Selector="^.small">
      <Setter Property="MinHeight" Value="{DynamicResource ControlHeightSmall}" />
      <Setter Property="Padding" Value="{DynamicResource PopUpButtonPaddingSmall}" />
      <Setter Property="CornerRadius" Value="{DynamicResource ButtonRadiusSmall}" />
      <Setter Property="FontSize" Value="{DynamicResource ControlFontSizeSmall}" />
      <Setter Property="LetterSpacing" Value="{DynamicResource ControlLetterSpacingSmall}" />
    </Style>
    <Style Selector="^.large /template/ cac|SymbolIcon#DropDownGlyph">
      <Setter Property="Margin" Value="21.75,0,10,0" />
      <Setter Property="FontSize" Value="13.5" />
    </Style>
    <Style Selector="^.large">
      <Setter Property="MinHeight" Value="{DynamicResource ControlHeightLarge}" />
      <Setter Property="Padding" Value="{DynamicResource PopUpButtonPaddingLarge}" />
      <Setter Property="CornerRadius" Value="{DynamicResource ButtonRadiusLarge}" />
      <Setter Property="FontSize" Value="{DynamicResource ControlFontSizeLarge}" />
    </Style>
    <Style Selector="^.xlarge /template/ cac|SymbolIcon#DropDownGlyph">
      <Setter Property="Margin" Value="28.75,0,13,0" />
      <Setter Property="FontSize" Value="13.5" />
    </Style>
    <Style Selector="^.xlarge">
      <Setter Property="MinHeight" Value="{DynamicResource ControlHeightXLarge}" />
      <Setter Property="Padding" Value="{DynamicResource PopUpButtonPaddingXLarge}" />
      <Setter Property="CornerRadius" Value="{DynamicResource ButtonRadiusXLarge}" />
      <Setter Property="FontSize" Value="{DynamicResource ControlFontSizeXLarge}" />
      <Setter Property="LetterSpacing" Value="{DynamicResource ControlLetterSpacingXLarge}" />
    </Style>

    <!-- Editable: the kit's "Combo Box", a text field with an arrow button inside; after the pop-up button's styles,
         which it overrides. The padding is the kit's field inset on the left, its "Text - Inset - Right" on the right.
         The arrow button's sizes and chevrons are measured on macOS 27 (NSComboBox), smaller than the kit's. -->
    <Style Selector="^[IsEditable=True]">
      <Setter Property="Background" Value="{DynamicResource TextFieldBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TextFieldBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ControlRadius}" />
      <Setter Property="Padding" Value="8,0,28,0" />

      <Style Selector="^:pressed /template/ Border#ArrowButton, ^:dropdownopen /template/ Border#ArrowButton">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPressedBrush}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Background" Value="{DynamicResource TextFieldBackgroundDisabledBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TextFieldBorderDisabledBrush}" />
      </Style>
      <Style Selector="^:disabled /template/ Border#ArrowButton">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundDisabledBrush}" />
      </Style>

      <Style Selector="^.mini">
        <Setter Property="CornerRadius" Value="{DynamicResource ControlRadiusMini}" />
        <Setter Property="Padding" Value="6,0,20,0" />
      </Style>
      <Style Selector="^.mini /template/ Border#ArrowButton">
        <Setter Property="Width" Value="14.5" />
        <Setter Property="Height" Value="9" />
        <Setter Property="Margin" Value="0,0,3.5,0" />
        <Setter Property="CornerRadius" Value="{DynamicResource ComboBoxRadiusButtonMini}" />
      </Style>
      <Style Selector="^.mini /template/ cac|SymbolIcon#ArrowGlyph">
        <Setter Property="Margin" Value="0.5,0,0,0" />
        <Setter Property="FontSize" Value="7.25" />
      </Style>
      <Style Selector="^.small">
        <Setter Property="CornerRadius" Value="{DynamicResource ControlRadiusSmall}" />
        <Setter Property="Padding" Value="6,0,24,0" />
      </Style>
      <Style Selector="^.small /template/ Border#ArrowButton">
        <Setter Property="Width" Value="19.5" />
        <Setter Property="Height" Value="13.5" />
        <Setter Property="Margin" Value="0,0,3,0" />
        <Setter Property="CornerRadius" Value="{DynamicResource ComboBoxRadiusButtonSmall}" />
      </Style>
      <Style Selector="^.large">
        <Setter Property="CornerRadius" Value="{DynamicResource ControlRadiusLarge}" />
        <Setter Property="Padding" Value="8,0,28,0" />
      </Style>
      <Style Selector="^.large /template/ Border#ArrowButton">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="19.5" />
        <Setter Property="Margin" Value="0,0,4.5,0" />
        <Setter Property="CornerRadius" Value="{DynamicResource ComboBoxRadiusButtonLarge}" />
      </Style>
      <Style Selector="^.large /template/ cac|SymbolIcon#ArrowGlyph">
        <Setter Property="Margin" Value="0,0,0,1" />
        <Setter Property="FontSize" Value="9.75" />
      </Style>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ComboBoxItem}" TargetType="ComboBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource LabelPrimaryBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource MenuFontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource ControlFontWeight}" />
    <Setter Property="MinHeight" Value="{DynamicResource MenuHeight}" />
    <Setter Property="Padding" Value="7,0" />
    <Setter Property="CornerRadius" Value="{DynamicResource MenuItemCornerRadius}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_LayoutRoot"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}"
                MinHeight="{TemplateBinding MinHeight}">
          <Grid ColumnDefinitions="Auto,*">
            <cac:SymbolIcon Name="PART_CheckGlyph" Width="9" Margin="1.5,0,9.5,0" Opacity="0"
                            VerticalAlignment="Center"
                            Symbol="checkmark" FontSize="10" FontWeight="Bold"
                            FallbackData="{StaticResource ComboBoxItemCheckGlyph}" FallbackStrokeThickness="1.6"
                            Foreground="{TemplateBinding Foreground}" />
            <ContentPresenter Name="PART_ContentPresenter"
                              Grid.Column="1"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover, ^:focus">
      <Setter Property="Background" Value="{DynamicResource MenuItemHighlightBrush}" />
    </Style>
    <Style Selector="^:selected /template/ cac|SymbolIcon#PART_CheckGlyph">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource LabelTertiaryBrush}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
