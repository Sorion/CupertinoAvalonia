<!--
  Button, from the kit's "Buttons" (page Buttons), Context=Content Area. DropDownButton is the kit's "Pulldown Button";
  SplitButton, which the kit lacks, follows AppKit's NSComboButton (split style).
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:cas="using:CupertinoAvalonia.Styling"
                    xmlns:cac="using:CupertinoAvalonia.Controls"
                    xmlns:converters="using:Avalonia.Controls.Converters">
  <Design.PreviewWith>
    <Border Padding="20">
      <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Bordered" />
          <Button Classes="accent" Content="Prominent" />
          <Button Classes="tinted" Content="Tinted" />
          <Button Classes="destructive" Content="Destructive" />
          <Button Classes="accent destructive" Content="Delete" />
          <Button Classes="borderless" Content="Borderless" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="mini" Content="Mini" />
          <Button Classes="small" Content="Small" />
          <Button Content="Regular" />
          <Button Classes="large" Content="Large" />
          <Button Classes="xlarge" Content="Extra large" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource LabelPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource ButtonRadius}" />
    <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
    <Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
    <Setter Property="LetterSpacing" Value="{DynamicResource ControlLetterSpacing}" />
    <Setter Property="FontWeight" Value="{DynamicResource ControlFontWeight}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <!-- Apart from the content: disabled states fade them differently. -->
          <Border Name="PART_Background"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}" />
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            RecognizesAccessKey="True"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:focus-visible /template/ Border#PART_Background">
      <Setter Property="AdornerLayer.Adorner">
        <Template>
          <Panel AdornerLayer.IsClipEnabled="False" IsHitTestVisible="False">
            <Border Classes="focus-ring" cas:OverflowAdorner.FollowAdorned="True" BoxShadow="{DynamicResource FocusRingShadow}" />
          </Panel>
        </Template>
      </Setter>
    </Style>

    <!-- Bordered -->
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPressedBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Background" Value="{DynamicResource ButtonBackgroundDisabledBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource LabelTertiaryBrush}" />
    </Style>

    <!-- Bordered - Tinted -->
    <Style Selector="^.tinted">
      <Setter Property="Background" Value="{DynamicResource ButtonTintedBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Style Selector="^:pressed">
        <Setter Property="Background" Value="{DynamicResource ButtonTintedBackgroundPressedBrush}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Background" Value="{DynamicResource ButtonTintedBackgroundDisabledBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Opacity" Value="0.4" />
        </Style>
      </Style>
    </Style>

    <!-- Bordered - Destructive -->
    <Style Selector="^.destructive">
      <Setter Property="Background" Value="{DynamicResource ButtonDestructiveBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentRedBrush}" />
      <Style Selector="^:pressed">
        <Setter Property="Background" Value="{DynamicResource ButtonDestructiveBackgroundPressedBrush}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Background" Value="{DynamicResource ButtonDestructiveBackgroundDisabledBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentRedBrush}" />
        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Opacity" Value="0.4" />
        </Style>
      </Style>
    </Style>

    <!-- Bordered - Prominent -->
    <Style Selector="^.accent, ^[IsDefault=True]">
      <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource WhiteBrush}" />
      <Style Selector="^:pressed">
        <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPressedBrush}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource WhiteBrush}" />
        <Style Selector="^ /template/ Border#PART_Background">
          <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Opacity" Value="0.5" />
        </Style>
      </Style>
    </Style>

    <!-- Bordered - Prominent Destructive -->
    <Style Selector="^.accent.destructive">
      <Setter Property="Background" Value="{DynamicResource AccentRedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource WhiteBrush}" />
      <Style Selector="^:pressed">
        <Setter Property="Background" Value="{DynamicResource ButtonProminentDestructiveBackgroundPressedBrush}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Background" Value="{DynamicResource AccentRedBrush}" />
      </Style>
    </Style>

    <!-- Borderless -->
    <Style Selector="^.borderless">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Style Selector="^:pressed">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AccentButtonBackgroundPressedBrush}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Opacity" Value="0.5" />
        </Style>
      </Style>
    </Style>

    <!-- Active=False: like Bordered. -->
    <Style Selector="^[(cas|WindowActivity.IsInactive)=True]">
      <Style Selector="^.accent, ^[IsDefault=True], ^.tinted, ^.destructive">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource LabelPrimaryBrush}" />
        <Style Selector="^:pressed">
          <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPressedBrush}" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Background" Value="{DynamicResource ButtonBackgroundDisabledBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource LabelTertiaryBrush}" />
          <Style Selector="^ /template/ Border#PART_Background, ^ /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="1" />
          </Style>
        </Style>
      </Style>
    </Style>

    <Style Selector="^.mini">
      <Setter Property="MinHeight" Value="{DynamicResource ControlHeightMini}" />
      <Setter Property="Padding" Value="{DynamicResource ButtonPaddingMini}" />
      <Setter Property="CornerRadius" Value="{DynamicResource ButtonRadiusMini}" />
      <Setter Property="FontSize" Value="{DynamicResource ControlFontSizeMini}" />
      <Setter Property="LetterSpacing" Value="{DynamicResource ControlLetterSpacingMini}" />
    </Style>
    <Style Selector="^.small">
      <Setter Property="MinHeight" Value="{DynamicResource ControlHeightSmall}" />
      <Setter Property="Padding" Value="{DynamicResource ButtonPaddingSmall}" />
      <Setter Property="CornerRadius" Value="{DynamicResource ButtonRadiusSmall}" />
      <Setter Property="FontSize" Value="{DynamicResource ControlFontSizeSmall}" />
      <Setter Property="LetterSpacing" Value="{DynamicResource ControlLetterSpacingSmall}" />
    </Style>
    <Style Selector="^.large">
      <Setter Property="MinHeight" Value="{DynamicResource ControlHeightLarge}" />
      <Setter Property="Padding" Value="{DynamicResource ButtonPaddingLarge}" />
      <Setter Property="CornerRadius" Value="{DynamicResource ButtonRadiusLarge}" />
      <Setter Property="FontSize" Value="{DynamicResource ControlFontSizeLarge}" />
      <Setter Property="LetterSpacing" Value="{DynamicResource ControlLetterSpacingLarge}" />
    </Style>
    <Style Selector="^.xlarge">
      <Setter Property="MinHeight" Value="{DynamicResource ControlHeightXLarge}" />
      <Setter Property="Padding" Value="{DynamicResource ButtonPaddingXLarge}" />
      <Setter Property="CornerRadius" Value="{DynamicResource ButtonRadiusXLarge}" />
      <Setter Property="FontSize" Value="{DynamicResource ControlFontSizeXLarge}" />
      <Setter Property="LetterSpacing" Value="{DynamicResource ControlLetterSpacingXLarge}" />
    </Style>
  </ControlTheme>

  <!-- Buttons - Toggle -->
  <ControlTheme x:Key="{x:Type ToggleButton}" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type Button}}">
    <Style Selector="^:checked">
      <Setter Property="Background" Value="{DynamicResource ButtonCheckedBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Style Selector="^:pressed">
        <Setter Property="Background" Value="{DynamicResource ButtonCheckedBackgroundPressedBrush}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Background" Value="{DynamicResource ButtonCheckedBackgroundDisabledBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Opacity" Value="0.3" />
        </Style>
      </Style>
    </Style>
    <!-- Pressing "off" previews "on". -->
    <Style Selector="^:unchecked:pressed">
      <Setter Property="Background" Value="{DynamicResource ButtonCheckedBackgroundPressedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <!-- Active=False: "on" looks like "off". -->
    <Style Selector="^[(cas|WindowActivity.IsInactive)=True]:checked">
      <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource LabelPrimaryBrush}" />
      <Style Selector="^:disabled">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundDisabledBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource LabelTertiaryBrush}" />
        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Opacity" Value="1" />
        </Style>
      </Style>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type RepeatButton}" TargetType="RepeatButton" BasedOn="{StaticResource {x:Type Button}}" />

  <StreamGeometry x:Key="PullDownChevron">M 0.75,0.75 L 4,4 L 7.25,0.75</StreamGeometry>
  <converters:CornerRadiusFilterConverter x:Key="SplitButtonLeftCorners" Filter="TopLeft, BottomLeft" />
  <converters:CornerRadiusFilterConverter x:Key="SplitButtonRightCorners" Filter="TopRight, BottomRight" />

  <!-- Pulldown Button: a button's styles and sizes, then a chevron.down (Disclosure/Font Size) in a 24 pt box. -->
  <ControlTheme x:Key="{x:Type DropDownButton}" TargetType="DropDownButton" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Padding" Value="{DynamicResource PopUpButtonPadding}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_Background"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}" />
          <Grid ColumnDefinitions="*,Auto">
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              RecognizesAccessKey="True"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            <cac:SymbolIcon Name="DropDownGlyph"
                            Grid.Column="1"
                            Width="{DynamicResource ControlHeight}"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Symbol="chevron.down"
                            FontSize="13"
                            FontWeight="Bold"
                            FallbackData="{StaticResource PullDownChevron}"
                            FallbackStrokeThickness="1.6" />
          </Grid>
        </Panel>
      </ControlTemplate>
    </Setter>

    <!-- Pressed while its menu is open. -->
    <Style Selector="^:flyout-open">
      <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPressedBrush}" />
    </Style>
    <Style Selector="^.accent:flyout-open, ^[IsDefault=True]:flyout-open">
      <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPressedBrush}" />
    </Style>
    <Style Selector="^.borderless:flyout-open">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AccentButtonBackgroundPressedBrush}" />
    </Style>

    <Style Selector="^.mini">
      <Setter Property="Padding" Value="{DynamicResource PopUpButtonPaddingMini}" />
      <Style Selector="^ /template/ cac|SymbolIcon#DropDownGlyph">
        <Setter Property="FontSize" Value="10" />
      </Style>
    </Style>
    <Style Selector="^.small">
      <Setter Property="Padding" Value="{DynamicResource PopUpButtonPaddingSmall}" />
      <Style Selector="^ /template/ cac|SymbolIcon#DropDownGlyph">
        <Setter Property="FontSize" Value="10" />
      </Style>
    </Style>
    <Style Selector="^.large">
      <Setter Property="Padding" Value="{DynamicResource PopUpButtonPaddingLarge}" />
    </Style>
    <Style Selector="^.xlarge">
      <Setter Property="Padding" Value="{DynamicResource PopUpButtonPaddingXLarge}" />
    </Style>
  </ControlTheme>

  <!--
    NSComboButton, split style, measured on macOS 27: two bordered parts side by side, without a separator, the menu's
    being square with a 9 pt chevron. ToggleSplitButton uses this theme too.
  -->
  <ControlTheme x:Key="{x:Type SplitButton}" TargetType="SplitButton">
    <Setter Property="Foreground" Value="{DynamicResource LabelPrimaryBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ButtonRadius}" />
    <!-- Popup/Inset - Left, on both sides: measured around the action's symbol. -->
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
    <Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
    <Setter Property="LetterSpacing" Value="{DynamicResource ControlLetterSpacing}" />
    <Setter Property="FontWeight" Value="{DynamicResource ControlFontWeight}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Holds the corner radius the focus ring copies. -->
        <Border Name="PART_Root" CornerRadius="{TemplateBinding CornerRadius}">
          <Grid ColumnDefinitions="*,Auto">
            <!-- The parts are bordered Buttons; the split button's size reaches them through these bindings. -->
            <Button Name="PART_PrimaryButton"
                    Focusable="False"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    MinHeight="{TemplateBinding MinHeight}"
                    Padding="{TemplateBinding Padding}"
                    CornerRadius="{TemplateBinding CornerRadius, Converter={StaticResource SplitButtonLeftCorners}}"
                    FontSize="{TemplateBinding FontSize}"
                    LetterSpacing="{TemplateBinding LetterSpacing}"
                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    Command="{TemplateBinding Command}"
                    CommandParameter="{TemplateBinding CommandParameter}" />
            <Button Name="PART_SecondaryButton"
                    Grid.Column="1"
                    Focusable="False"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Padding="0"
                    MinHeight="{TemplateBinding MinHeight}"
                    MinWidth="{TemplateBinding MinHeight}"
                    CornerRadius="{TemplateBinding CornerRadius, Converter={StaticResource SplitButtonRightCorners}}">
              <cac:SymbolIcon Name="DropDownGlyph"
                              Symbol="chevron.down"
                              FontSize="9"
                              FontWeight="SemiBold"
                              FallbackData="{StaticResource PullDownChevron}"
                              FallbackStrokeThickness="1.4" />
            </Button>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:focus-visible /template/ Border#PART_Root">
      <Setter Property="AdornerLayer.Adorner">
        <Template>
          <Panel AdornerLayer.IsClipEnabled="False" IsHitTestVisible="False">
            <Border Classes="focus-ring" cas:OverflowAdorner.FollowAdorned="True" BoxShadow="{DynamicResource FocusRingShadow}" />
          </Panel>
        </Template>
      </Setter>
    </Style>
    <Style Selector="^:flyout-open /template/ Button#PART_SecondaryButton">
      <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPressedBrush}" />
    </Style>

    <!-- ToggleSplitButton, "on": as an "on" toggle button. -->
    <Style Selector="^:checked">
      <Style Selector="^ /template/ Button">
        <Setter Property="Background" Value="{DynamicResource ButtonCheckedBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      </Style>
      <Style Selector="^:flyout-open /template/ Button#PART_SecondaryButton">
        <Setter Property="Background" Value="{DynamicResource ButtonCheckedBackgroundPressedBrush}" />
      </Style>
    </Style>
    <Style Selector="^[(cas|WindowActivity.IsInactive)=True]:checked">
      <Style Selector="^ /template/ Button">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource LabelPrimaryBrush}" />
      </Style>
    </Style>

    <Style Selector="^.mini">
      <Setter Property="MinHeight" Value="{DynamicResource ControlHeightMini}" />
      <Setter Property="Padding" Value="7,0" />
      <Setter Property="CornerRadius" Value="{DynamicResource ButtonRadiusMini}" />
      <Setter Property="FontSize" Value="{DynamicResource ControlFontSizeMini}" />
      <Setter Property="LetterSpacing" Value="{DynamicResource ControlLetterSpacingMini}" />
      <Style Selector="^ /template/ cac|SymbolIcon#DropDownGlyph">
        <Setter Property="FontSize" Value="7" />
      </Style>
    </Style>
    <Style Selector="^.small">
      <Setter Property="MinHeight" Value="{DynamicResource ControlHeightSmall}" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="CornerRadius" Value="{DynamicResource ButtonRadiusSmall}" />
      <Setter Property="FontSize" Value="{DynamicResource ControlFontSizeSmall}" />
      <Setter Property="LetterSpacing" Value="{DynamicResource ControlLetterSpacingSmall}" />
      <Style Selector="^ /template/ cac|SymbolIcon#DropDownGlyph">
        <Setter Property="FontSize" Value="8" />
      </Style>
    </Style>
    <Style Selector="^.large">
      <Setter Property="MinHeight" Value="{DynamicResource ControlHeightLarge}" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="CornerRadius" Value="{DynamicResource ButtonRadiusLarge}" />
      <Setter Property="FontSize" Value="{DynamicResource ControlFontSizeLarge}" />
      <Setter Property="LetterSpacing" Value="{DynamicResource ControlLetterSpacingLarge}" />
      <Style Selector="^ /template/ cac|SymbolIcon#DropDownGlyph">
        <Setter Property="FontSize" Value="10" />
      </Style>
    </Style>
    <Style Selector="^.xlarge">
      <Setter Property="MinHeight" Value="{DynamicResource ControlHeightXLarge}" />
      <Setter Property="Padding" Value="18,0" />
      <Setter Property="CornerRadius" Value="{DynamicResource ButtonRadiusXLarge}" />
      <Setter Property="FontSize" Value="{DynamicResource ControlFontSizeXLarge}" />
      <Setter Property="LetterSpacing" Value="{DynamicResource ControlLetterSpacingXLarge}" />
      <Style Selector="^ /template/ cac|SymbolIcon#DropDownGlyph">
        <Setter Property="FontSize" Value="11" />
      </Style>
    </Style>
  </ControlTheme>
</ResourceDictionary>
