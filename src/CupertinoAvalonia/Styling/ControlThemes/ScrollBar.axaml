<!-- ScrollBar, from the kit's "Scrollbar - Vertical/Horizontal" (page Scrollbar). -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Design.PreviewWith>
    <ScrollViewer Width="200" Height="120">
      <StackPanel>
        <TextBlock Text="Line 1" /><TextBlock Text="Line 2" /><TextBlock Text="Line 3" />
        <TextBlock Text="Line 4" /><TextBlock Text="Line 5" /><TextBlock Text="Line 6" />
        <TextBlock Text="Line 7" /><TextBlock Text="Line 8" /><TextBlock Text="Line 9" />
      </StackPanel>
    </ScrollViewer>
  </Design.PreviewWith>

  <ControlTheme x:Key="CupertinoScrollBarPageButton" TargetType="RepeatButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="CupertinoScrollBarThumb" TargetType="Thumb">
    <Setter Property="Background" Value="{DynamicResource ScrollBarThumbBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="100" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
    <Setter Property="Cursor" Value="Arrow" />

    <Style Selector="^:vertical">
      <Setter Property="Width" Value="12" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Name="Root" Background="Transparent">
            <Border Name="TrackRect" Background="{DynamicResource FillQuaternaryBrush}" Opacity="0" />
            <Track Name="PART_Track"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value, Mode=TwoWay}"
                   ViewportSize="{TemplateBinding ViewportSize}"
                   Orientation="{TemplateBinding Orientation}"
                   IsDirectionReversed="True"
                   DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}">
              <Track.DecreaseButton>
                <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource CupertinoScrollBarPageButton}" />
              </Track.DecreaseButton>
              <Track.IncreaseButton>
                <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource CupertinoScrollBarPageButton}" />
              </Track.IncreaseButton>
              <Thumb Theme="{StaticResource CupertinoScrollBarThumb}" Margin="3" MinHeight="20" />
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="^:horizontal">
      <Setter Property="Height" Value="12" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Name="Root" Background="Transparent">
            <Border Name="TrackRect" Background="{DynamicResource FillQuaternaryBrush}" Opacity="0" />
            <Track Name="PART_Track"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value, Mode=TwoWay}"
                   ViewportSize="{TemplateBinding ViewportSize}"
                   Orientation="{TemplateBinding Orientation}"
                   DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}">
              <Track.DecreaseButton>
                <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource CupertinoScrollBarPageButton}" />
              </Track.DecreaseButton>
              <Track.IncreaseButton>
                <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource CupertinoScrollBarPageButton}" />
              </Track.IncreaseButton>
              <Thumb Theme="{StaticResource CupertinoScrollBarThumb}" Margin="3" MinWidth="20" />
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="^ /template/ Border#TrackRect">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^[IsExpanded=true] /template/ Border#TrackRect">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
