<Project>
  <!-- See https://aka.ms/dotnet/msbuild/customize for more details on customizing your build -->
  <PropertyGroup>
    <Copyright>Copyright (C) 2023-2026 Sorion</Copyright>
    <!-- The texts the theme ships ("Hide Sidebar"…) are AppKit's English ones. -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- The version the theme is built and tested against. -->
    <AvaloniaVersion>12.0.5</AvaloniaVersion>
  </PropertyGroup>

  <!-- Reproducible builds in CI (paths in symbols and Source Link map to the repository). -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
